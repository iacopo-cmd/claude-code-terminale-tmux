#!/bin/bash
# lavori-barra - contenuto della barra di stato tmux (in basso). Monitora, per default tutto acceso:
#   ⏱ tempo trascorso della sessione · 🪙 token della conversazione corrente · ● sessioni aperte
# Lo chiama tmux (status-right) col nome sessione:  #(lavori-barra #S)
# Spiegazione della leggenda: comando "aiuto".
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
IDX=${LAVORI_DIR:-/etc/lavori}/indice.tsv
PROG=${PROGETTI_CLAUDE:-$HOME/.claude/projects}

s=${1:-}; [ -n "$s" ] || exit 0
nfmt(){ local n=${1:-0}
  if   [ "$n" -ge 1000000 ]; then printf '%d.%dM' $((n/1000000)) $(((n%1000000)/100000))
  elif [ "$n" -ge 1000 ];    then printf '%dk' $((n/1000))
  else printf '%d' "$n"; fi; }

out=""
# ⏱ tempo trascorso della sessione
creato=$(tmux list-sessions -F '#{session_name} #{session_created}' 2>/dev/null | awk -v n="$s" '$1==n{print $2; exit}')
if [ -n "$creato" ]; then
  d=$(( $(date +%s) - creato )); [ "$d" -lt 0 ] && d=0
  out+="⏱ $(printf '%dh%02dm' $((d/3600)) $(((d%3600)/60)))"
fi
# 🪙 token della conversazione corrente (ultimo .jsonl della cartella del lavoro di questa sessione)
cart=$(awk -F'\t' -v n="$s" '!/^#/ && $2==n{print $3; exit}' "$IDX" 2>/dev/null)
if [ -n "$cart" ]; then
  key=$(printf '%s' "$cart" | sed 's/[^A-Za-z0-9]/-/g')
  f=$(ls -t "$PROG/$key"/*.jsonl 2>/dev/null | head -1)
  if [ -n "$f" ]; then
    tok=$(grep -hoE '"(input_tokens|output_tokens)":[0-9]+' "$f" 2>/dev/null | grep -oE '[0-9]+' | awk '{s+=$1} END{printf "%d", s+0}')
    out+=" · 🪙 $(nfmt "$tok")"
  fi
fi
# ● sessioni aperte adesso
na=$(tmux list-sessions 2>/dev/null | grep -c .)
out+=" · ● $na aperte"
out="${out# · }"      # niente separatore iniziale se manca il tempo (sessione non in corso)
printf ' %s ' "$out"
