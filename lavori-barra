#!/bin/bash
# lavori-barra - contenuto della barra di stato tmux (in basso), tutto su UNA riga, per default tutto acceso:
#   MACCHINA (nome host e indirizzo) · ⏱ tempo trascorso della sessione · 🪙 token della conversazione corrente
#   · 🧠 modello in uso (💰 al posto di 🧠 se e' nella lista di quelli a pagamento) · ● sessioni aperte · ✎ come si accende/spegne l'iacopostyle e com'e' adesso · la firma
#   e, solo quando serve, davanti a tutto: ⚠ metti a tutto schermo (il terminale e' piccolo per i pannelli)
# Lo chiama tmux col nome sessione:  #(lavori-barra #S)      (nelle sessioni di "lavori" sta a sinistra, accanto
# al nome: vedi la funzione "barra" in lavori).  Secondo argomento "senzafirma": toglie comando e firma.
# Se la riga non entra nel terminale si accorcia da sola (via "aperte", "per la mod:", poi l'indirizzo); la firma mai.
# ✍ = tempo VERO di lavoro (buchi di piu' di 60 s senza scambi non contano): sessione · lavoro · tutti i lavori.
# LAVORI_MACCHINA="testo" cambia la scritta della macchina, LAVORI_MACCHINA="" la toglie.
# Modello: l'ultimo usato nella conversazione (dal .jsonl; dopo un /model si aggiorna alla prima risposta).
# Modelli a pagamento: uno per riga (anche solo un pezzo del nome, es. fable-5-2) in $LAVORI_DIR/modelli-a-pagamento.
# Spiegazione della leggenda: comando "aiuto".
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C.UTF-8          # cosi' la lunghezza della riga si conta in caratteri e non in byte
# --riga1 / --tempi: la barra su DUE righe (cosi' le scritte restano intere): sopra la sostanza, sotto i tempi veri
# di lavoro e, per ultimo, l'interruttore dello stile. Senza opzioni: tutto su una riga, come prima.
# Tre righe (28/11), tutte scritte per intero:
#   --riga1  dove e con cosa:  macchina · modello · contesto · abbonamento · firma
#   --conti  quanto costa:     tempo aperta · sessioni aperte · 💶 costo · 🪙 token · 📝 righe
#   --tempi  tempo vero:       ✍ sessione · questo lavoro · tutti i lavori · per ultimo l'interruttore dello stile
# Dal 28/11 le righe sono QUATTRO, a pannello: un'etichetta colorata a sinistra e le voci in colonna, su fondo scuro
#   --riga1    MACCHINA   macchina · lavoro · aperta da · le ALTRE sessioni aperte (se ci sono) · firma
#   --modello  MODELLO    modello · contesto · abbonamento
#   --conti    COSTO      sessione · questo lavoro · agenti · token · righe
#   --tempi    TEMPO      lavoro vero (sessione, lavoro, tutti) · per ultimo l'interruttore dello stile
#   --limiti   ABBONAMENTO  quanto hai usato e quanto resta dei limiti (5 ore, settimana) e quando si azzerano
TEMPI=0; RIGA1=0; CONTI=0; MODELLO=0; LIMITI=0
case "${1:-}" in --tempi) TEMPI=1; shift ;; --riga1) RIGA1=1; shift ;; --conti) CONTI=1; shift ;; --modello) MODELLO=1; shift ;; --limiti) LIMITI=1; shift ;; esac
IDX=${LAVORI_DIR:-/etc/lavori}/indice.tsv
PROG=${PROGETTI_CLAUDE:-$HOME/.claude/projects}
FIRMA="Iacopo, 6 novembre 2026"          # nome e data FISSA: restano per sempre

s=${1:-}; [ -n "$s" ] || exit 0
nfmt(){ local n=${1:-0}
  if   [ "$n" -ge 1000000 ]; then printf '%d.%dM' $((n/1000000)) $(((n%1000000)/100000))
  elif [ "$n" -ge 1000 ];    then printf '%dk' $((n/1000))
  else printf '%d' "$n"; fi; }

avviso=""
stile=on; [ "$(head -1 "${LAVORI_DIR:-/etc/lavori}/stile" 2>/dev/null)" = off ] && stile=off   # lavori iacopo on|off
# ⚠ schermo troppo piccolo per i pannelli (vedi "lavori guida"): lo dice qui, in italiano. Servono 120 colonne;
#   la plancia vuole anche 26 righe di terminale (= 25 di finestra, una se la prende questa barra).
read -r larg alt < <(tmux display-message -p -t "=$s:" '#{window_width} #{window_height}' 2>/dev/null)
if [ "$stile" = on ] && [[ "${larg:-}" =~ ^[0-9]+$ && "${alt:-}" =~ ^[0-9]+$ ]]; then
  minalt=0; [ "$(head -1 "${LAVORI_DIR:-/etc/lavori}/guida" 2>/dev/null)" = plancia ] && minalt=25
  if [ "$larg" -lt 120 ] || [ "$alt" -lt "$minalt" ]; then
    avviso="⚠ metti a tutto schermo (ora ${larg}x$((alt+1)))"
  fi
fi
# la MACCHINA: nome host e indirizzo, per non sbagliare macchina quando se ne hanno piu' d'una aperta
if [ -z "${LAVORI_MACCHINA+x}" ]; then
  ind=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
  mac="$(hostname)${ind:+ $ind}"
else mac=$LAVORI_MACCHINA; fi
# ⏱ tempo di apertura della sessione (riparte da zero a ogni sessione nuova)
dur(){ local d=${1:-0}; [ "$d" -lt 0 ] && d=0
  if [ "$d" -ge 360000 ]; then printf '%dh' $((d/3600)); else printf '%dh%02dm' $((d/3600)) $(((d%3600)/60)); fi; }
tempo=""
creato=$(tmux list-sessions -F '#{session_name} #{session_created}' 2>/dev/null | awk -v n="$s" '$1==n{print $2; exit}')
[ -n "$creato" ] && tempo="⏱ $(dur $(( $(date +%s) - creato )))"
# 🪙 token della conversazione corrente (ultimo .jsonl della cartella del lavoro di questa sessione)
gettoni=""; modello=""; lampo=0
cart=$(awk -F'\t' -v n="$s" '!/^#/ && $2==n{print $3; exit}' "$IDX" 2>/dev/null)
if [ -n "$cart" ]; then
  key=$(printf '%s' "$cart" | sed 's/[^A-Za-z0-9]/-/g')
  f=$(ls -t "$PROG/$key"/*.jsonl 2>/dev/null | head -1)
  if [ -n "$f" ]; then
    tok=$(grep -hoE '"(input_tokens|output_tokens)":[0-9]+' "$f" 2>/dev/null | grep -oE '[0-9]+' | awk '{s+=$1} END{printf "%d", s+0}')
    gettoni="🪙 $(nfmt "$tok")"
    # 🧠 modello: il piu' recente tra l'ultima risposta ("model":"claude-opus-5-5") e l'ultimo /model ("Set model to
    #    `Fable 5.1`"), cosi' cambia subito quando lo cambi, senza aspettare la risposta
    ult=$(tac "$f" 2>/dev/null | grep -m1 -oE '"model":"claude-[a-z0-9-]+"|stdout>Set mode[l] to `[A-Z][a-z]+ [0-9][^`]*`')
    ult=${ult#stdout>}     # solo il vero esito del comando /model, non la stessa frase citata in un testo
    mid=""; bello=""
    case "$ult" in
      '"model":'*) mid=$(printf '%s' "$ult" | sed -E 's/.*"(claude-[^"]+)"/\1/')
                   bello=$(printf '%s' "${mid#claude-}" | sed -E 's/-([0-9]+)-([0-9]+)$/ \1.\2/; s/-([0-9]+)$/ \1/; s/^./\u&/') ;;
      Set*)        bello=$(printf '%s' "$ult" | sed -E 's/^Set model to `//; s/`$//; s/ *\([^)]*\)//g')
                   mid="claude-$(printf '%s' "$bello" | tr 'A-Z' 'a-z' | sed -E 's/[ .]+/-/g')" ;;
    esac
    if [ -n "$mid" ]; then
      icona="🧠"
      while IFS= read -r caro; do
        caro=${caro%%#*}; caro=${caro//[[:space:]]/}; [ -n "$caro" ] || continue
        [[ "$mid" == *"$caro"* ]] && { icona="💰"; break; }
      done < <(cat "${IDX%/*}/modelli-a-pagamento" 2>/dev/null)
      # Fable, di qualsiasi versione, costa un botto: sempre 💰 e in barra LAMPEGGIA (cambia colore ogni 2 secondi)
      # Haiku, il piu' piccolo: lampeggia in bianco e nero a inversione, per ricordare di non dargli cose difficili
      case "$mid" in *fable*) icona="💰"; lampo=1 ;; *haiku*) lampo=2 ;; esac
      modello="$icona $bello"
    fi
  fi
fi
# 📦 ⏳ i dati che Claude Code passa alla sua riga di stato (li salva avviso-tmux.sh in <dati>/claude/<sessione>.json):
#   modello, contesto attuale e suo limite, costo e righe cambiate della sessione, limiti dell'abbonamento (5 ore, 7 giorni)
contesto=""; limiti=""; c_costo=""; c_righe=""
CJ="${IDX%/*}/claude/$s.json"
if [ -s "$CJ" ] && command -v python3 >/dev/null; then
  IFS='|' read -r c_mod c_ctx c_max c_perc c_5h c_7g c_costo c_add c_tol c_5h_fine c_7g_fine < <(python3 -I - "$CJ" <<'PY' 2>/dev/null
import sys, json
d = json.load(open(sys.argv[1])); g = lambda *k: (lambda o: [o := (o or {}).get(x) for x in k][-1])(d)
cu = g("context_window", "current_usage") or {}
ctx = sum(cu.get(k) or 0 for k in ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
v = [g("model", "display_name") or "", ctx, g("context_window", "context_window_size") or 0,
     g("context_window", "used_percentage"), g("rate_limits", "five_hour", "used_percentage"),
     g("rate_limits", "seven_day", "used_percentage"), g("cost", "total_cost_usd"),
     g("cost", "total_lines_added"), g("cost", "total_lines_removed"),
     g("rate_limits", "five_hour", "resets_at"), g("rate_limits", "seven_day", "resets_at")]
print("|".join("" if x is None else (f"{x:.2f}" if isinstance(x, float) else str(x)) for x in v))
PY
  )
  if [[ "${c_max:-}" =~ ^[0-9]+$ ]] && [ "$c_max" -gt 0 ]; then
    [[ "${c_perc:-}" =~ ^[0-9]+$ ]] || c_perc=$(( c_ctx * 100 / c_max ))
    ic="📦"; [ "$c_perc" -ge 80 ] && ic="⚠"
    contesto="$ic contesto $(nfmt "$c_ctx")/$(nfmt "$c_max") $c_perc%"
  fi
  # Claude Code a volte passa solo uno dei due limiti: si mostra quello che c'e'
  l=""; [[ "${c_5h:-}" =~ ^[0-9]+$ ]] && l="5h $c_5h%"
  [[ "${c_7g:-}" =~ ^[0-9]+$ ]] && l+="${l:+ · }7gg $c_7g%"
  if [ -n "$l" ]; then
    limiti="⏳ abbonamento $l"
    { [ "${c_5h:-0}" -ge 80 ] || [ "${c_7g:-0}" -ge 80 ]; } && limiti="⚠ abbonamento $l"
  fi
  [[ "${c_add:-}" =~ ^[0-9]+$ ]] && c_righe="📝 +$c_add/-${c_tol:-0}"
fi
# ✍ tempo VERO di lavoro: dagli orari della conversazione (tuoi messaggi, risposte e passi di Claude). Un buco di piu'
#   di 60 secondi in cui nessuno scrive NON conta. Tre conti: questa sessione, questo lavoro (tutte le sue
#   conversazioni), tutti i lavori dell'indice. Cache per file in <cartella dei dati>/attivo.cache: si rilegge solo
#   la parte nuova dei file che crescono, cosi' ogni 5 secondi costa poco.
attivo=""
if { [ "$TEMPI" = 1 ] || [ "$CONTI" = 1 ]; } && [ -n "$cart" ] && command -v python3 >/dev/null; then
  mapfile -t tutte < <(awk -F'\t' '!/^#/ && $3!=""{print $3}' "$IDX" 2>/dev/null)
  read -r a_sess a_lav a_tut t_lav e_lav e_ag e_ses < <(python3 -I - "$PROG" "$key" "${creato:-0}" "${IDX%/*}/attivo.cache" "$HOME/.claude.json" "${tutte[@]}" <<'PY' 2>/dev/null
import sys, os, re, json, glob, datetime
prog, key, creato, cache, conf = sys.argv[1], sys.argv[2], int(sys.argv[3] or 0), sys.argv[4], sys.argv[5]
cartelle = sys.argv[6:]
BUCO = 60
VER = 2                                     # formato della cache: se cambia, si riparte da zero
RT = re.compile(rb'"timestamp":"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)')
def sec(b):
    return int(datetime.datetime.strptime(b.decode(), "%Y-%m-%dT%H:%M:%S").replace(tzinfo=datetime.timezone.utc).timestamp())
try: C = json.load(open(cache)); C = C if C.get("_ver") == VER else {"_ver": VER}
except Exception: C = {"_ver": VER}
try: PREZZI = json.load(open(conf)).get("additionalModelCostsCache") or {}     # dollari per milione di token
except Exception: PREZZI = {}
def prezzo(m):
    if m in PREZZI: return PREZZI[m]
    for k in sorted(PREZZI, key=len, reverse=True):
        if m.startswith(k): return PREZZI[k]
    return None
def costo(m, u):
    p = prezzo(m) or {}
    cc = u.get("cache_creation") or {}
    w1h = cc.get("ephemeral_1h_input_tokens") or 0
    w5m = (u.get("cache_creation_input_tokens") or 0) - w1h
    return ((u.get("input_tokens") or 0) * p.get("inputTokens", 0) + (u.get("output_tokens") or 0) * p.get("outputTokens", 0)
            + w5m * p.get("promptCacheWriteTokens", 0) + w1h * p.get("promptCacheWrite1hTokens", 0)
            + (u.get("cache_read_input_tokens") or 0) * p.get("promptCacheReadTokens", 0)) / 1e6
def conto(f, da=0):
    """del file: secondi attivi, token (tutti e 4 i tipi), dollari; da>0 = solo da quell'ora in poi"""
    st = os.stat(f); k = f + (f"@{da}" if da else "")
    c = C.get(k)
    nuovo = {"dim": 0, "tot": 0, "ult": 0, "tok": 0, "usd": 0.0, "id": ""}
    if c and all(x in c for x in nuovo) and c["dim"] <= st.st_size and c["mt"] <= st.st_mtime: c = dict(c)
    else: c = nuovo
    if c["dim"] < st.st_size:
        with open(f, "rb") as h:
            h.seek(c["dim"]); dati = h.read()
        fine = dati.rfind(b"\n") + 1           # solo righe complete
        for riga in dati[:fine].split(b"\n"):
            m = RT.search(riga)
            if not m: continue
            t = sec(m.group(1))
            if da and t < da: continue
            if c["ult"] and 0 < t - c["ult"] <= BUCO: c["tot"] += t - c["ult"]
            if t > c["ult"]: c["ult"] = t
            if b'"usage"' in riga and b'"assistant"' in riga:
                try: o = json.loads(riga)
                except Exception: continue
                msg = o.get("message") or {}; u = msg.get("usage") or {}
                mid = msg.get("id") or o.get("requestId") or ""
                if not u or mid == c["id"]: continue      # la stessa risposta e' scritta in piu' righe: si conta una volta
                c["id"] = mid
                c["tok"] += sum(u.get(x) or 0 for x in ("input_tokens", "output_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
                c["usd"] += costo(msg.get("model") or "", u)
        c["dim"] += fine
    c["mt"] = st.st_mtime; C[k] = c
    return c
def file_di(k):  return glob.glob(os.path.join(prog, k, "*.jsonl"))
def agenti_di(k): return glob.glob(os.path.join(prog, k, "*", "subagents", "*.jsonl"))
chiave = lambda c: re.sub(r"[^A-Za-z0-9]", "-", c)
L = [conto(f) for f in file_di(key)]; A = [conto(f) for f in agenti_di(key)]
lav = sum(x["tot"] for x in L); tok = sum(x["tok"] for x in L + A)
usd = sum(x["usd"] for x in L + A); ag = sum(x["usd"] for x in A)
tut = sum(conto(f)["tot"] for k in sorted({chiave(c) for c in cartelle}) for f in file_di(k))
S = [conto(f, creato) for f in file_di(key) + agenti_di(key) if os.stat(f).st_mtime >= creato] if creato else []
ses = sum(x["tot"] for x in S if True); sesusd = sum(x["usd"] for x in S)
try:
    tmp = cache + ".nuovo"; json.dump(C, open(tmp, "w")); os.replace(tmp, cache)
except Exception: pass
print(ses, lav, tut, tok, f"{usd:.2f}", f"{ag:.2f}", f"{sesusd:.2f}")
PY
  )
  [[ "${a_sess:-}" =~ ^[0-9]+$ ]] && attivo="✍ lavoro vero (senza le pause): sessione $(dur "$a_sess") · questo lavoro $(dur "$a_lav") · tutti i lavori $(dur "$a_tut")"
fi
soldi(){ LC_ALL=C printf '%.0f $' "${1:-0}" 2>/dev/null; }   # dollari arrotondati
# --- il pannello: colori di tmux (#[...]), non occupano posto. Fondo blu notte (lo mette "lavori"), etichetta
#     colorata, parole in azzurro tenue, valori in crema grassetto, separatore sottile.
#     REGOLA (Iacopo, 28/11): ogni voce deve dire DA SOLA cosa e': niente sigle, niente numeri senza dire se e'
#     usato o rimasto, le durate scritte "13 min" / "1 h 38 min".
G='#[fg=colour110,nobold]'; V='#[fg=colour229,bold]'; Z='#[default]'; SEP=" #[fg=colour61,nobold]│$Z "
etichetta(){ printf '#[fg=colour232,bg=%s,bold] %-11s#[default] ' "$1" "$2"; }      # etichetta <colore> <nome>
voce(){ printf '%s%s %s%s%s' "$G" "$1" "$V" "$2" "$Z"; }                             # voce <parola> <valore>
perc(){ local c=colour114; [ "$1" -ge 60 ] && c=colour221; [ "$1" -ge 80 ] && c=colour203   # verde, giallo, rosso
        printf '#[fg=%s,bold]%s%%%s' "$c" "$1" "$Z"; }
fila(){ local o="" x; for x in "$@"; do [ -n "$x" ] && o+="${o:+$SEP}$x"; done; printf '%s' "$o"; }
chiaro(){ local d=${1:-0}; [ "$d" -lt 0 ] && d=0                                     # durata in chiaro
  if   [ "$d" -ge 360000 ]; then printf '%d h' $((d/3600))
  elif [ "$d" -ge 3600 ];   then printf '%d h %d min' $((d/3600)) $(((d%3600)/60))
  else printf '%d min' $((d/60)); fi; }
milioni(){ local n=${1:-0}                                                           # numero di token in chiaro
  if [ "$n" -ge 1000000 ] && [ "$n" -lt 1100000 ]; then printf '1 milione'
  elif [ "$n" -ge 1000000 ]; then printf '%d,%d milioni' $((n/1000000)) $(((n%1000000)/100000))
  elif [ "$n" -ge 1000 ]; then printf '%d mila' $((n/1000)); else printf '%d' "$n"; fi; }
adesso=$(date +%s)
na=$(tmux list-sessions 2>/dev/null | grep -c .)
if [ "$RIGA1" = 1 ]; then      # MACCHINA: dove sei
  p_avv=""; [ -n "$avviso" ] && p_avv="#[fg=colour232,bg=colour221,bold] $avviso $Z"
  p_mac=""; [ -n "$mac" ] && p_mac="${G}server$Z $V${mac%% *}$Z $G${mac#* }$Z"; [ "$mac" = "${mac%% *}" ] && p_mac=$(voce server "$mac")
  p_ap=""; [ -n "$creato" ] && p_ap=$(voce "aperta da" "$(chiaro $((adesso-creato)))")
  # le ALTRE sessioni aperte oltre a questa (questa non si segna: lo sai gia'); se non ce ne sono, niente
  p_na=""; altre=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -vxF "$s" | paste -sd, | sed 's/,/, /g')
  if [ -n "$altre" ]; then
    [ "${#altre}" -gt 40 ] && altre="$(( na - 1 ))"
    p_na="#[fg=colour221,nobold]altre sessioni aperte:$Z #[fg=colour221,bold]$altre$Z"
  fi
  p_firma=""; [ "${2:-}" != senzafirma ] && p_firma="$G$FIRMA$Z"
  printf '%s%s ' "$(etichetta colour39 MACCHINA)" "$(fila "$p_avv" "$p_mac" "$(voce lavoro "$s")" "$p_ap" "$p_na" "$p_firma")"; exit 0
fi
if [ "$MODELLO" = 1 ]; then    # MODELLO: con cosa lavori e quanta memoria della chat e' piena
  p_mod=""
  if [ -n "$modello" ]; then
    col="fg=colour229,bold"; nota=""
    if [ "$lampo" = 1 ]; then    # Fable: giro di colori ogni 2 secondi (scritta rossa, tranne su rosso e arancione)
      giro=("fg=white,bg=red" "fg=red,bg=yellow" "fg=red,bg=magenta" "fg=red,bg=cyan" "fg=red,bg=blue" "fg=black,bg=colour208" "fg=red,bg=white")
      col="${giro[$(( adesso / 2 % ${#giro[@]} ))]},bold"; nota=" #[fg=colour203,bold]costa caro$Z"
    elif [ "$lampo" = 2 ]; then  # Haiku: bianco e nero a inversione
      if [ $(( adesso / 2 % 2 )) -eq 0 ]; then col="fg=black,bg=white,bold"; else col="fg=white,bg=black,bold"; fi
      nota=" ${G}modello piccolo: niente cose difficili$Z"
    fi
    p_mod="${G}stai usando$Z #[$col] ${modello#* } $Z$nota"
  fi
  p_ctx=""
  if [[ "${c_max:-}" =~ ^[0-9]+$ ]] && [ "$c_max" -gt 0 ]; then
    p_ctx="${G}memoria della chat piena al$Z $(perc "$c_perc") $G($(milioni "$c_ctx") token su $(milioni "$c_max"))$Z"
    if [ "$c_perc" -ge 80 ]; then p_ctx+=" #[fg=colour203,bold]⚠ quasi piena: fai /compact$Z"
    else p_ctx+=" $G· resta libero il$Z $V$((100-c_perc))%$Z"; fi
  fi
  printf '%s%s ' "$(etichetta colour177 MODELLO)" "$(fila "$p_mod" "$p_ctx")"; exit 0
fi
if [ "$LIMITI" = 1 ]; then     # ABBONAMENTO: i due limiti, quanto e' usato, quanto resta, quando si azzera
  GG=(dom lun mar mer gio ven sab)
  limite(){   # limite <nome> <percentuale usata> <ora di azzeramento> <corto|lungo>
    local nome=$1 u=$2 fine=$3 o
    if ! [[ "$u" =~ ^[0-9]+$ ]]; then printf '%s%s: dato non disponibile adesso%s' "$G" "$nome" "$Z"; return; fi
    o="$G$nome: usato$Z $(perc "$u")$G, resta$Z $V$((100-u))%$Z"
    if [[ "$fine" =~ ^[0-9]+$ ]] && [ "$fine" -gt "$adesso" ]; then
      if [ "$4" = corto ]; then o+="$G, si azzera alle$Z $V$(date -d "@$fine" +%H:%M)$Z $G(tra $(chiaro $((fine-adesso))))$Z"
      else o+="$G, si azzera$Z $V${GG[$(date -d "@$fine" +%w)]} $(date -d "@$fine" +%d/%m)$Z ${G}alle$Z $V$(date -d "@$fine" +%H:%M)$Z"; fi
    fi
    printf '%s' "$o"; }
  if [ -s "$CJ" ]; then
    printf '%s%s ' "$(etichetta colour80 ABBONAMENTO)" "$(fila "$(limite "5 ore" "${c_5h:-}" "${c_5h_fine:-}" corto)" "$(limite "settimana" "${c_7g:-}" "${c_7g_fine:-}" lungo)")"
  else
    printf '%s%s ' "$(etichetta colour80 ABBONAMENTO)" "${G}i limiti compaiono dopo la prima risposta di Claude$Z"
  fi
  exit 0
fi
if [ "$CONTI" = 1 ]; then      # COSTO: quanto varrebbe il lavoro pagando a consumo (listino API)
  ses_usd=${c_costo:-${e_ses:-}}                         # il costo della sessione lo da' Claude Code; se manca, il nostro conto
  # il lavoro dalle conversazioni salvate (se Claude Code le ha compattate la storia vecchia puo' mancare):
  # non scende mai sotto la sessione
  [ -n "${e_lav:-}" ] && [ -n "$ses_usd" ] && e_lav=$(awk -v a="$e_lav" -v b="$ses_usd" 'BEGIN{printf "%.2f", (b>a)?b:a}')
  p_ses=""; [ -n "$ses_usd" ] && p_ses=$(voce "questa sessione" "$(soldi "$ses_usd")")
  p_lav=""; [ -n "${e_lav:-}" ] && p_lav=$(voce "tutto il lavoro circa" "$(soldi "$e_lav")")
  p_ag="";  [ -n "${e_ag:-}" ] && [ "${e_ag%.*}" != 0 ] && p_ag=$(voce "di cui sottoagenti" "$(soldi "$e_ag")")
  p_tok=""; [[ "${t_lav:-}" =~ ^[0-9]+$ ]] && p_tok=$(voce "token del lavoro" "$(milioni "$t_lav")")
  p_righe=""; [[ "${c_add:-}" =~ ^[0-9]+$ ]] && p_righe="${G}righe:$Z #[fg=colour114,bold]$c_add aggiunte$Z$G,$Z #[fg=colour203,bold]${c_tol:-0} tolte$Z"
  printf '%s%s ' "$(etichetta colour215 COSTO)" "$(fila "${G}pagando a consumo:$Z $p_ses" "$p_lav" "$p_ag" "$p_tok" "$p_righe")"; exit 0
fi
if [ "$TEMPI" = 1 ]; then      # TEMPO: il lavoro vero; per ultimo l'interruttore dello stile
  p_vero=""
  [[ "${a_sess:-}" =~ ^[0-9]+$ ]] && p_vero="${G}senza le pause:$Z $(voce "questa sessione" "$(chiaro "$a_sess")") $G·$Z $(voce "tutto il lavoro" "$(chiaro "$a_lav")") $G·$Z $(voce "tutti i lavori" "$(chiaro "$a_tut")")"
  acc=spenta; [ "$stile" = on ] && acc=accesa
  if [ "${2:-}" != senzafirma ]; then p_stile="${G}✎ mod pannelli:$Z $V$acc$Z $G(${Z}${V}iacopo on | off$Z$G)$Z"; else p_stile="${G}mod dei pannelli $acc$Z"; fi
  printf '%s%s ' "$(etichetta colour114 "TEMPO VERO")" "$(fila "$p_vero" "$p_stile")"; exit 0
fi
# ● sessioni aperte adesso
na=$(tmux list-sessions 2>/dev/null | grep -c .)

# la riga, in tre misure: larga, stretta, minima; si usa la piu' larga che entra nel terminale
riga(){   # riga <larga|stretta|minima> [senzafirma]
  # ordine (voluto da Iacopo, 24/11): prima la sostanza, lo stile per ultimo ->
  #   macchina · modello · token · tempo · sessioni aperte · firma · interruttore dell'iacopostyle
  local o="" p m=$mac
  [ "$1" = minima ] && m=${mac%% *}                                 # minima: la macchina senza indirizzo
  local ctx=$contesto lim=$limiti
  [ "$1" != larga ] && { ctx=${ctx/contesto /}; lim=${lim/abbonamento /}; }
  if [ "$RIGA1" = 1 ]; then
    for p in "$avviso" "$m" "$modello" "$contesto" "$limiti"; do [ -n "$p" ] && o+=" · $p"; done
    [ "${2:-}" != senzafirma ] && o+=" · $FIRMA"
    printf '%s' "${o# · }"; return
  fi
  for p in "$avviso" "$m" "$modello" "$ctx" "$lim" "$tempo"; do [ -n "$p" ] && o+=" · $p"; done
  if [ "$1" = larga ]; then o+=" · ● $na aperte"; else o+=" · ● $na"; fi
  if [ "$RIGA1" = 1 ]; then
    [ "${2:-}" != senzafirma ] && o+=" · $FIRMA"                    # l'interruttore dello stile sta nella seconda riga
  elif [ "${2:-}" != senzafirma ]; then
    o+=" · $FIRMA"
    case "$1" in
      larga)   o+=" · ✎ per la mod: iacopo off | on (ora $stile)" ;;
      stretta) o+=" · ✎ iacopo off|on ($stile)" ;;
      *)       o+=" · ✎ $stile" ;;
    esac
  else o+=" · iacopostyle $stile"; fi
  printf '%s' "${o# · }"
}
# celle occupate: i caratteri piu' uno per ogni simbolo largo (le emoji prendono due colonne)
celle(){ local x=$1 e; e=$(printf '%s' "$x" | grep -o '[⏱✍🪙🧠💰●✎⚠]' | wc -l); echo $(( ${#x} + e )); }
out=$(riga larga "${2:-}")
# spazio a disposizione: larghezza del terminale meno "[nome sessione] " e un margine
if [[ "${larg:-}" =~ ^[0-9]+$ ]]; then
  for misura in stretta minima; do
    [ $(( $(celle "$out") + ${#s} + 5 )) -le "$larg" ] && break
    out=$(riga "$misura" "${2:-}")
  done
fi
# il lampeggio si mette DOPO aver misurato la riga (i codici di colore di tmux non occupano posto)
if [ "$lampo" = 2 ] && [ -n "$modello" ]; then
  if [ $(( $(date +%s) / 2 % 2 )) -eq 0 ]; then col="#[fg=black,bg=white,bold]"; else col="#[fg=white,bg=black,bold]"; fi
  out=${out/"$modello"/"$col $modello #[default]"}
elif [ "$lampo" = 1 ] && [ -n "$modello" ]; then
  # giro di colori, uno ogni 2 secondi; la scritta e' ROSSA su tutti gli sfondi, tranne sul rosso e sull'arancione
  # (li' sarebbe illeggibile: bianca sul rosso, nera sull'arancione). Niente verde: e' il colore della barra, spariva
  giro=("fg=white,bg=red" "fg=red,bg=yellow" "fg=red,bg=magenta" "fg=red,bg=cyan" "fg=red,bg=blue" "fg=black,bg=colour208" "fg=red,bg=white")
  col="#[${giro[$(( $(date +%s) / 2 % ${#giro[@]} ))]},bold]"
  out=${out/"$modello"/"$col $modello #[default]"}
fi
printf '%s ' "$out"
