#!/usr/bin/env python3
# lavori-risposte - pannello "risposte": mostra solo le tue battute e le risposte in testo di Claude,
# senza tool e senza codice, seguendo dal vivo il transcript (.jsonl) del lavoro. Pensato per stare in
# un pannello tmux sopra a Claude Code: sotto scorre il codice, qui il discorso resta fermo.
#
# Uso:  lavori-risposte [nome-lavoro | cartella] [--tu | --claude | --sospese] [--stampa]
#   --sospese (2026-11-10): solo le DOMANDE di Claude ancora SENZA risposta, con la clessidra (⏳ ?). Il pannello si
#   ridisegna da solo: quando rispondi le domande passano sotto, spente, con la tua risposta (✔). Niente altro.
#   --tu: solo le tue battute        --claude: solo le risposte di Claude   (per tenerle in due pannelli)
#   con --tu compaiono anche le DOMANDE che Claude ti fa (frasi che finiscono con "?" e le domande a scelta),
#   in fila tra le tue battute: cosi' vedi cosa aspetta risposta e cosa hai risposto.
#   senza argomenti: dentro tmux usa il nome della sessione, altrimenti la cartella corrente
#   --stampa: stampa quello che c'e' ed esce (senza restare in ascolto)
# Prova a mano, dentro la sessione di un lavoro:
#   tmux split-window -h -d -l 60% lavori-risposte
# "lavori <nome>" lo apre da solo a destra se lo schermo e' largo; quando Claude si chiude e questo
# pannello resta solo (o solo con altri lavori-risposte), esce (cosi' la sessione tmux non resta appesa).
import datetime, glob, json, os, re, shutil, subprocess, sys, textwrap, time

IDX = os.path.join(os.environ.get('LAVORI_DIR', '/etc/lavori'), 'indice.tsv')
PROG = os.environ.get('PROGETTI_CLAUDE', os.path.expanduser('~/.claude/projects'))
COLORI = sys.stdout.isatty() and not os.environ.get('NO_COLOR')
C = (lambda c, s: f'\033[{c}m{s}\033[0m') if COLORI else (lambda c, s: s)


def cartella_del_lavoro(arg):
    """nome lavoro/sessione (o cartella) -> cartella del lavoro"""
    if arg and (os.sep in arg or os.path.isdir(arg)):
        return os.path.abspath(arg)
    if not arg and os.environ.get('TMUX'):
        try:
            pan = ['-t', os.environ['TMUX_PANE']] if os.environ.get('TMUX_PANE') else []
            arg = subprocess.run(['tmux', 'display-message', '-p'] + pan + ['#S'],
                                 capture_output=True, text=True, timeout=5).stdout.strip()
        except Exception:
            arg = ''
    if arg:
        try:
            with open(IDX, encoding='utf-8', errors='replace') as f:
                for riga in f:
                    c = riga.rstrip('\n').split('\t')
                    if riga.startswith('#') or len(c) < 3:
                        continue
                    if arg.lower() in (c[0].lower(), c[1].lower()):
                        return c[2]
        except OSError:
            pass
        if len(sys.argv) > 1 and not sys.argv[1].startswith('--'):
            sys.exit(f'lavori-risposte: lavoro "{arg}" non trovato in {IDX}')
    return os.getcwd()


def ultimo_jsonl(cart):
    chiave = re.sub(r'[^A-Za-z0-9]', '-', cart)
    files = glob.glob(os.path.join(PROG, chiave, '*.jsonl'))
    return max(files, key=os.path.getmtime) if files else None


def ora(o):
    try:
        t = datetime.datetime.fromisoformat(o['timestamp'].replace('Z', '+00:00'))
        return t.astimezone().strftime('%H:%M')
    except Exception:
        return ''


def testo_di(o):
    """riga del transcript -> ('tu'|'claude', testo) oppure None se non e' discorso"""
    if o.get('isSidechain') or o.get('isMeta'):
        return None
    tipo = o.get('type')
    if tipo not in ('user', 'assistant'):
        return None
    cont = (o.get('message') or {}).get('content')
    if isinstance(cont, list):
        cont = '\n'.join(b.get('text', '') for b in cont
                         if isinstance(b, dict) and b.get('type') == 'text')
    if not isinstance(cont, str):
        return None
    cont = cont.strip()
    if tipo == 'user':
        # via i blocchi di servizio (comandi locali, promemoria di sistema)
        cont = re.sub(r'<(system-reminder|local-command-[a-z]+|command-[a-z]+)>.*?</\1>', '',
                      cont, flags=re.S).strip()
    if not cont:
        return None
    if o.get('isApiErrorMessage'):              # errore API: una riga sola, non tutto il papiro
        return 'errore', cont.split('\n')[0]
    return ('tu' if tipo == 'user' else 'claude'), cont


def domande_di(o):
    """riga del transcript -> le domande che Claude fa in quel messaggio (lista, anche vuota)"""
    if o.get('type') != 'assistant' or o.get('isSidechain') or o.get('isApiErrorMessage'):
        return []
    cont = (o.get('message') or {}).get('content')
    if isinstance(cont, str):
        cont = [{'type': 'text', 'text': cont}]
    out = []
    for b in cont if isinstance(cont, list) else []:
        if not isinstance(b, dict):
            continue
        if b.get('type') == 'tool_use' and b.get('name') == 'AskUserQuestion':
            for q in (b.get('input') or {}).get('questions') or []:
                if isinstance(q, dict) and q.get('question'):
                    out.append(str(q['question']).strip())
        elif b.get('type') == 'text':
            codice = False
            for riga in b.get('text', '').split('\n'):
                if riga.lstrip().startswith('```'):
                    codice = not codice
                elif not codice and '?' in riga:
                    riga = re.sub(r'^\s*(?:[-*•]\s+|\d+\.\s+|#+\s+)', '', riga).replace('**', '')
                    for frase in re.split(r'(?<=[.!?:])\s+', riga):
                        frase = frase.strip()
                        if len(frase) > 2 and frase.rstrip('*_)"” ').endswith('?'):
                            out.append(frase)
    return out


def a_capo(testo, largh):
    """va a capo sulle parole; i blocchi ``` restano come sono"""
    out, codice = [], False
    for riga in testo.split('\n'):
        if riga.lstrip().startswith('```'):
            codice = not codice
            out.append(riga)
        elif codice or len(riga) <= largh:
            out.append(riga)
        else:
            rientro = re.match(r'\s*(?:[-*•]\s+|\d+\.\s+)?', riga).group(0)
            out.extend(textwrap.wrap(riga, largh, subsequent_indent=' ' * len(rientro),
                                     break_long_words=False, break_on_hyphens=False) or [''])
    return '\n'.join(out)


ultimo_chi = None
SOLO = ('tu' if '--tu' in sys.argv[1:] else 'claude' if '--claude' in sys.argv[1:]
        else 'sospese' if '--sospese' in sys.argv[1:] else None)
SOSPESE, CHIUSE, DISEGNATO = [], [], [None]     # --sospese: (ora, domanda) in attesa; (ora, domanda, risposta) chiuse


def sospese(o):
    """--sospese: tiene il conto delle domande aperte. Una battuta tua le chiude tutte (e' la risposta)."""
    d = domande_di(o)
    if d:
        SOSPESE.extend((ora(o), x) for x in d)
        return
    r = testo_di(o)
    if r and r[0] == 'tu' and SOSPESE:
        risposta = ' '.join(r[1].split())
        CHIUSE.extend((h, q, risposta) for h, q in SOSPESE)
        del SOSPESE[:], CHIUSE[:-12]


def disegna():
    """--sospese: ridisegna il pannello (solo se e' cambiato qualcosa o la misura)"""
    dim = shutil.get_terminal_size((100, 12))
    stato = (len(SOSPESE), len(CHIUSE), CHIUSE[-1:] , dim.columns, dim.lines)
    if stato == DISEGNATO[0]:
        return
    DISEGNATO[0] = stato
    largh = max(20, dim.columns - 6)
    out = []
    if SOSPESE:
        out.append(C('1;35', f'⏳ DOMANDE IN SOSPESO  {len(SOSPESE)}') + C('2', '   (rispondi sotto)'))
        for h, q in SOSPESE:
            righe = a_capo(q, largh).split('\n')
            out.append(C('1;35', '⏳ ? ') + C('35', righe[0]) + C('2', f'  {h}'))
            out.extend(C('35', '     ' + r) for r in righe[1:])
    else:
        out.append(C('1;32', '✔ nessuna domanda in sospeso'))
    liberi = dim.lines - len(out) - 2
    if CHIUSE and liberi >= 2:
        out.append('')
        out.append(C('2', '── gia\' risposte ──'))
        for h, q, risp in reversed(CHIUSE[-max(1, (liberi - 1) // 2):]):
            out.append(C('2', '✔ ? ' + textwrap.shorten(q, largh, placeholder='…')))
            out.append(C('2;33', '     ▶ ' + textwrap.shorten(risp, largh - 2, placeholder='…')))
    if not sys.stdout.isatty():
        print('\n'.join(out), flush=True)
        return
    sys.stdout.write('\033[2J\033[H' + '\n'.join(out[:max(1, dim.lines - 1)]))
    sys.stdout.flush()


def stampa(o):
    global ultimo_chi
    if SOLO == 'sospese':
        sospese(o)
        return
    if SOLO == 'tu':
        domande = domande_di(o)
        if domande:
            largh = max(20, shutil.get_terminal_size((100, 24)).columns - 5)
            print(f'\n{C("1;35", "? CLAUDE CHIEDE")} {C("2", ora(o))}')
            for d in domande:
                righe = a_capo(d, largh).split('\n')
                for i, riga in enumerate(righe):
                    print(C('35', ('  ? ' if i == 0 else '    ') + riga))
            sys.stdout.flush()
            ultimo_chi = 'domande'
            return
    r = testo_di(o)
    if not r:
        return
    chi, testo = r
    if SOLO and SOLO != ('claude' if chi == 'errore' else chi):
        ultimo_chi = None                       # ha parlato l'altro: alla prossima rimetto l'intestazione
        return
    largh = max(20, shutil.get_terminal_size((100, 24)).columns - 3)
    if chi == 'errore':
        print('  ' + C('2;31', '✗ ' + textwrap.shorten(testo, largh - 2, placeholder='…')), flush=True)
        ultimo_chi = None                       # dopo un errore si riparte con l'intestazione
        return
    if chi != ultimo_chi:
        if chi == 'tu':
            testa = C('1;33', '▶ TU')
        else:
            testa = C('1;36', '● CLAUDE')
        print(f'\n{testa} {C("2", ora(o))}')
        ultimo_chi = chi
    else:
        print()
    for riga in a_capo(testo, largh).split('\n'):
        print('  ' + (C('33', riga) if chi == 'tu' else riga))
    sys.stdout.flush()


def leggi(f, resto):
    """legge le righe nuove complete; ritorna il pezzo di riga ancora incompleto"""
    dati = resto + f.read()
    righe = dati.split('\n')
    for riga in righe[:-1]:
        if riga.strip():
            try:
                stampa(json.loads(riga))
            except ValueError:
                pass
    return righe[-1]


def altri_pannelli():
    """quanti pannelli della mia finestra tmux NON sono lavori-risposte (-1 = non lo so / fuori da tmux)"""
    pan = os.environ.get('TMUX_PANE')
    if not (os.environ.get('TMUX') and pan):
        return -1
    try:
        r = subprocess.run(['tmux', 'list-panes', '-t', pan, '-F', '#{pane_start_command}'],
                           capture_output=True, text=True, timeout=5)
        if r.returncode != 0:
            return -1
        return sum(1 for c in r.stdout.splitlines() if 'lavori-risposte' not in c)
    except Exception:
        return -1


def main():
    args = [a for a in sys.argv[1:] if not a.startswith('--')]
    una_volta = '--stampa' in sys.argv[1:]
    cart = cartella_del_lavoro(args[0] if args else '')
    corrente, f, resto, avvisato, giro = None, None, '', False, 0
    affiancato = altri_pannelli() > 0           # nato accanto a Claude Code: quando lui chiude, chiudo anch'io
    while True:
        if giro % 4 == 0:                       # ogni ~2s: e' partita una conversazione nuova?
            if affiancato and altri_pannelli() == 0:
                break
            nuovo = ultimo_jsonl(cart)
            if nuovo and nuovo != corrente:
                if f:
                    f.close()
                    print('\n' + C('2', '─── nuova conversazione ───'))
                corrente, resto = nuovo, ''
                del SOSPESE[:], CHIUSE[:]
                f = open(corrente, encoding='utf-8', errors='replace')
            elif not nuovo and not avvisato and not una_volta:
                print(C('2', f'in attesa della prima conversazione in {cart} ...'), flush=True)
                avvisato = True
        if f:
            resto = leggi(f, resto)
        if SOLO == 'sospese':
            disegna()
        if una_volta:
            break
        giro += 1
        time.sleep(0.5)


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        pass
    except BrokenPipeError:                     # es. "lavori-risposte --stampa | head"
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
