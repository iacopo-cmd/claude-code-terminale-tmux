#!/bin/bash
# lavori - gestione dei lavori (progetti) di Claude Code nel terminale, con tmux.
# https://github.com/iacopo-cmd/claude-code-terminale-tmux  -  LEGGERE LE AVVERTENZE NEL README.
#
# Un LAVORO = una cartella + una sessione tmux con Claude dentro.
#  - Claude Code tiene conversazioni e memoria PER CARTELLA (~/.claude/projects/<cartella>/) e legge il
#    CLAUDE.md della cartella all'avvio: cartelle diverse = contesti separati.
#  - tmux tiene viva la sessione se cade l'SSH: ci si riattacca e Claude e' ancora li'.
#  - Separa il CONTESTO, non i PERMESSI: tutte le sessioni girano come root.
#
# Comandi:
#   lavori                                MENU interattivo (nel terminale): scegli col numero, n = nuovo, ...
#   lavori elenco                         solo l'elenco dei lavori, con stato (anche negli script)
#   lavori <nome> [id-conversazione]      apre il lavoro (riattacca la sessione o la crea; con l'id riprende
#                                         quella conversazione invece dell'ultima)
#   lavori 0                              LAVORO ZERO "Aggiornamenti" (uguale: lavori aggiornamenti; nel menu: 0):
#                                         un terminale di root dentro tmux, SENZA Claude e senza pannelli, per
#                                         gli aggiornamenti e i comandi lunghi. Se cade il collegamento il comando
#                                         continua: rientri con "lavori 0" e lo ritrovi dov'era. Non sta
#                                         nell'indice, c'e' sempre; si chiude scrivendo exit.
#   lavori opencode                       OPENCODE (nel menu: il numero dopo l'ultimo lavoro): un terminale tmux con
#                                         OpenCode dentro, al posto di Claude. Gira come l'utente che lo apre (entri
#                                         come iacopo = iacopo, come root = root), nella sua ~/opencode; compare solo
#                                         se quell'utente ha OpenCode. Non serve root. LAVORI_OPENCODE_CARTELLA e
#                                         LAVORI_OPENCODE_CMD cambiano cartella e comando.
#   lavori stato                          stato degli aggiornamenti (apt): se ce n'e' uno in corso e se gira dentro
#                                         o fuori da tmux, se e' rimasto qualcosa a meta', quanti pacchetti restano,
#                                         se serve il riavvio. Se trova qualcosa di incastrato scrive i comandi per
#                                         riprendere e, dentro tmux, chiede se mandarlo avanti lui. Il lavoro zero
#                                         lo mostra da solo quando si apre.
#   lavori nuovo <nome> <cartella> ["descrizione"]   crea un lavoro (cartella e CLAUDE.md se mancano)
#   lavori info <nome>                    dettagli: cartella, CLAUDE.md, memoria, conversazioni con gli id
#   lavori descrivi <nome> "descrizione"  cambia la descrizione
#   lavori togli <nome>                   toglie dall'indice (NON cancella cartella ne' conversazioni)
#   lavori ore [<nome>]                   ore per sessione e totale (di un lavoro, o totali di tutti)
#   lavori guida [europea|inglese|egiziana|plancia]   come stanno i pannelli: europea = scrivi a sinistra
#                                         (default); inglese o egiziana = scrivi a destra; plancia = tre pannelli
#                                         (sopra le risposte, sotto scrivi a sinistra e a destra le tue battute
#                                         con le domande di Claude). Senza argomenti dice quale hai.
#   lavori iacopo [on|off]                iacopostyle: accende o spegne i pannelli su TUTTE le sessioni,
#                                         aperte e nuove (uguale: lavori stile, lavori styl, lavori iacopostyle;
#                                         comando corto: iacopo on | iacopo off).
#                                         Senza on/off dice com'e' adesso. La barra in basso resta sempre: a
#                                         sinistra ricorda il comando, a destra dice se e' on o off.
#   lavori promemoria                     due righe: lavori aperti e come si usa (per il login SSH)
#   lavori aiuto                          questo testo
#
# Nomi e cartelle: niente spazi (nome: minuscole, numeri, - e _; cartella: nessuno spazio nel percorso).
# Ore: ogni sessione aperta segna inizio e fine; il totale e' la somma delle sessioni chiuse; la riga di stato
#      mostra ora d'inizio e tempo trascorso dal vivo (anche se la sessione la apre uno script tuo che chiama "lavori <nome>").
# Scambi:    aprendo un lavoro su uno schermo largo (>= 120 colonne) la sessione si divide in due: a sinistra
#            Claude Code dove scrivi e passa il codice, a destra gli scambi tu <-> Claude (lavori-risposte:
#            restano fermi). LAVORI_RISPOSTE=0 lo spegne; LAVORI_RISPOSTE_MIN cambia la soglia di colonne.
#            La disposizione si sceglie con "lavori guida" (resta salvata in /etc/lavori/guida); per una
#            volta sola, nelle guide di fianco: LAVORI_RISPOSTE_LATO=sinistra|destra (lato degli scambi).
#            La plancia vuole anche almeno 26 righe, senno' apre di fianco come l'europea.
# Indice:    /etc/lavori/indice.tsv  (nome, sessione tmux, cartella, creato, ultimo uso, descrizione)
#            copia prima di ogni modifica in /etc/lavori/indice.tsv.prima; blocco con flock
# Registro:  /var/log/lavori.log    (aperture, creazioni, rimozioni)
# In tmux:   Ctrl-b d = staccati senza chiudere   Ctrl-b s = passa a un altro lavoro
set -uo pipefail

DIR=${LAVORI_DIR:-/etc/lavori}
INDICE=$DIR/indice.tsv
BLOCCO=$DIR/.blocco
REGISTRO=${LAVORI_REGISTRO:-/var/log/lavori.log}
CLAUDE_BIN=${CLAUDE_BIN:-$(command -v claude || echo "$HOME/.local/bin/claude")}
PROGETTI_CLAUDE=${PROGETTI_CLAUDE:-$HOME/.claude/projects}
INTESTAZIONE=$'# nome\tsessione\tcartella\tcreato\tultimo_uso\tdescrizione'
# Scritta nella barra di tmux, accanto al nome della sessione, tutta su una riga (la scrive lavori-barra):
# la MACCHINA (nome host e indirizzo), i contatori (tempo, token, sessioni aperte), come si accende/spegne la mod
# e la firma. Resta anche con la mod spenta, cosi' si sa come riaccenderla (LAVORI_FIRMA="" toglie comando e firma)
FIRMA=${LAVORI_FIRMA-✎ per la mod: iacopo off | on · Iacopo, 6 novembre 2026}
RISERVATI=" nuovo info descrivi togli aiuto elenco help menu promemoria ore guida iacopo iacopostyle stile styl 0 zero zero-nota zero-comandi stato aggiornamenti Aggiornamenti opencode OpenCode o "
# Lavoro ZERO: fisso, fuori dall'indice. Un terminale di root in tmux per gli aggiornamenti (niente Claude, niente pannelli)
ZERO_NOME=Aggiornamenti
ZERO_SESS=Aggiornamenti
ZERO_DESCR="Terminale di root per gli aggiornamenti, senza Claude: se cade il collegamento il comando continua e lo ritrovi qui"
# OpenCode: fisso, fuori dall'indice. Gira come l'utente che lancia lavori (niente cambio di utente)
OC_NOME=OpenCode
OC_SESS=OpenCode
OC_CARTELLA=${LAVORI_OPENCODE_CARTELLA:-$HOME/opencode}
OC_CMD=${LAVORI_OPENCODE_CMD:-}
if [ -z "$OC_CMD" ]; then
    if [ -x "$HOME/.opencode/bin/opencode" ]; then OC_CMD="$HOME/.opencode/bin/opencode"
    else OC_CMD=$(command -v opencode 2>/dev/null || true); fi
fi
oc_ce() { [ -n "$OC_CMD" ] && [ -x "$OC_CMD" ]; }
OC_DESCR="OpenCode al posto di Claude, come $(id -un), in $OC_CARTELLA"

errore() { printf 'lavori: %s\n' "$*" >&2; exit 1; }
registra() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')" "$*" >> "$REGISTRO" 2>/dev/null || true; }
ora() { date '+%Y-%m-%d %H:%M'; }

# --- Cornice dell'elenco/menu: bash puro (conta i caratteri in UTF-8), si adatta alla larghezza del terminale ---
_line() { local n=$1 c=${2:-─} o=""; while [ "$n" -gt 0 ]; do o+="$c"; n=$((n-1)); done; printf '%s' "$o"; }
_pad()  { local s=$1 w=$2; [ "${#s}" -gt "$w" ] && s=${s:0:$w}; printf '%s%*s' "$s" "$(( w - ${#s} ))" ""; }
_cen()  { local s=$1 w=$2; local len=${#s} l; [ "$len" -ge "$w" ] && { printf '%s' "${s:0:$w}"; return; }
          l=$(( (w-len)/2 )); printf '%*s%s%*s' "$l" "" "$s" "$(( w-len-l ))" ""; }
_wrap() { local t=$1 w=$2 l="" x; for x in $t; do
            if [ -z "$l" ]; then l=$x
            elif [ $(( ${#l}+1+${#x} )) -le "$w" ]; then l="$l $x"
            else printf '%s\n' "$l"; l=$x; fi
            while [ "${#l}" -gt "$w" ]; do printf '%s\n' "${l:0:$w}"; l="${l:$w}"; done
          done; [ -n "$l" ] && printf '%s\n' "$l"; }
_render() {   # $1 = menu|elenco ; in "menu" numera le righe e popola NOMI[] (per la scelta col numero)
    local mode=$1 W CW i=0 nome sess cart creato uso descr dot left right gap rl tot
    W=${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}; [ "$W" -gt 100 ] && W=100; [ "$W" -lt 54 ] && W=54
    CW=$((W-2)); [ "$mode" = menu ] && NOMI=()
    tot=$(righe | grep -c . 2>/dev/null || echo 0)
    printf '\033[36m╭%s╮\033[0m\n' "$(_line "$CW")"
    printf '\033[36m│\033[0m\033[1m%s\033[0m\033[36m│\033[0m\n' "$(_cen "Lavori di Claude Code   ($tot)" "$CW")"
    # il lavoro ZERO sta sempre in cima e non conta nel totale (non e' un lavoro di Claude)
    printf '\033[36m├%s┤\033[0m\n' "$(_line "$CW")"
    if aperta "$ZERO_SESS"; then dot="●"; else dot="○"; fi
    if [ "$mode" = menu ]; then left="  $(_pad 0 2) $dot $ZERO_NOME"; else left="  $dot $ZERO_NOME"; fi
    right="lavori 0 "
    gap=$(( CW - ${#left} - ${#right} )); [ "$gap" -lt 1 ] && gap=1
    printf '\033[36m│\033[0m%s\033[36m│\033[0m\n' "$(_pad "$left$(_line "$gap" ' ')$right" "$CW")"
    while IFS= read -r rl; do printf '\033[36m│\033[0m%s\033[36m│\033[0m\n' "$(_pad "       $rl" "$CW")"; done < <(_wrap "$ZERO_DESCR" $((CW-9)))
    while IFS=$'\t' read -r nome sess cart creato uso descr; do
        [ -z "$nome" ] && continue
        printf '\033[36m├%s┤\033[0m\n' "$(_line "$CW")"
        i=$((i+1)); [ "$mode" = menu ] && NOMI+=("$nome")
        if aperta "$sess"; then dot="●"; elif [ ! -d "$cart" ]; then dot="✗"; else dot="○"; fi
        if [ "$mode" = menu ]; then left="  $(_pad "$i" 2) $dot $nome"; else left="  $dot $nome"; fi
        right="ultimo uso ${uso:--} "
        gap=$(( CW - ${#left} - ${#right} )); [ "$gap" -lt 1 ] && gap=1
        printf '\033[36m│\033[0m%s\033[36m│\033[0m\n' "$(_pad "$left$(_line "$gap" ' ')$right" "$CW")"
        while IFS= read -r rl; do printf '\033[36m│\033[0m%s\033[36m│\033[0m\n' "$(_pad "       $rl" "$CW")"; done < <(_wrap "${descr:--}" $((CW-9)))
    done < <(righe)
    if oc_ce; then   # OpenCode in fondo, col numero dopo l'ultimo lavoro (solo se c'e')
        printf '\033[36m├%s┤\033[0m\n' "$(_line "$CW")"
        if aperta "$OC_SESS"; then dot="●"; else dot="○"; fi
        if [ "$mode" = menu ]; then left="  $(_pad $((i+1)) 2) $dot $OC_NOME"; else left="  $dot $OC_NOME"; fi
        right="lavori opencode "
        gap=$(( CW - ${#left} - ${#right} )); [ "$gap" -lt 1 ] && gap=1
        printf '\033[36m│\033[0m%s\033[36m│\033[0m\n' "$(_pad "$left$(_line "$gap" ' ')$right" "$CW")"
        while IFS= read -r rl; do printf '\033[36m│\033[0m%s\033[36m│\033[0m\n' "$(_pad "       $rl" "$CW")"; done < <(_wrap "$OC_DESCR" $((CW-9)))
    fi
    printf '\033[36m╰%s╯\033[0m\n' "$(_line "$CW")"
}

prepara() {
    [ "$(id -u)" -eq 0 ] || errore "va lanciato come root"
    command -v tmux >/dev/null || errore "tmux non installato"
    mkdir -p "$DIR" && chmod 700 "$DIR"
    if [ ! -s "$INDICE" ]; then   # primo avvio: indice vuoto
        echo "$INTESTAZIONE" > "$INDICE"
        chmod 600 "$INDICE"
        registra "indice creato"
    fi
}

# Legge l'indice senza intestazione e righe vuote
righe() { grep -v '^#' "$INDICE" | grep -v '^[[:space:]]*$' || true; }
campo() { righe | awk -F'\t' -v n="$1" -v c="$2" '$1 == n { print $c; exit }'; }
esiste() { [ -n "$(campo "$1" 1)" ]; }
# risolve un nome scritto in qualsiasi maiuscole/minuscole nel nome VERO dell'indice (o niente)
canon()  { righe | awk -F'\t' -v n="$1" 'BEGIN{n=tolower(n)} tolower($1)==n{print $1; exit}'; }

# Modifica l'indice in modo sicuro: blocco, copia, scrittura su file temporaneo, sostituzione
modifica() {   # modifica <comando awk che legge stdin e scrive il nuovo indice>
    exec 9>"$BLOCCO"
    flock -w 10 9 || errore "indice occupato da un altro comando, riprova"
    cp -p "$INDICE" "$INDICE.prima"
    if awk -F'\t' -v OFS='\t' "$@" "$INDICE" > "$INDICE.nuovo" && [ -s "$INDICE.nuovo" ]; then
        chmod 600 "$INDICE.nuovo" && mv "$INDICE.nuovo" "$INDICE"
    else
        rm -f "$INDICE.nuovo"; errore "modifica dell'indice non riuscita (indice invariato)"
    fi
    exec 9>&-
}

cartella_claude() { printf '%s/%s' "$PROGETTI_CLAUDE" "$(printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g')"; }
aperta() { tmux has-session -t "=$1" 2>/dev/null; }

elenco() {
    _render elenco
    echo "  Apri: lavori <nome>  ·  Nuovo: lavori nuovo <nome> <cartella> \"descrizione\"  ·  Dettagli: lavori info <nome>"
    echo "  ● aperto   ○ chiuso   ✗ manca"
}

info() {
    local nome; nome=$(canon "$1"); [ -n "$nome" ] || nome=$1
    esiste "$nome" || errore "lavoro sconosciuto: $1 (elenco: lavori)"
    local sess cart cc
    sess=$(campo "$nome" 2); cart=$(campo "$nome" 3); cc=$(cartella_claude "$cart")
    echo "Lavoro:       $nome — $(campo "$nome" 6)"
    echo "Cartella:     $cart $([ -d "$cart" ] || echo '(NON ESISTE)')"
    echo "Sessione:     tmux \"$sess\" $(aperta "$sess" && echo '(aperta)' || echo '(chiusa)')"
    echo "Creato:       $(campo "$nome" 4)    ultimo uso: $(campo "$nome" 5)"
    echo "CLAUDE.md:    $([ -f "$cart/CLAUDE.md" ] && echo "$cart/CLAUDE.md ($(wc -l < "$cart/CLAUDE.md") righe)" || echo 'manca')"
    echo "Memoria:      $([ -d "$cc/memory" ] && echo "$cc/memory ($(find "$cc/memory" -name '*.md' | wc -l) file)" || echo 'nessuna')"
    echo "Conversazioni (ultima in cima; per riprenderne una: lavori $nome <id>):"
    if compgen -G "$cc/*.jsonl" >/dev/null; then
        ls -t "$cc"/*.jsonl | head -10 | while read -r f; do
            printf '  %s  %s  %s\n' "$(basename "$f" .jsonl)" "$(date -r "$f" '+%Y-%m-%d %H:%M')" "$(du -h "$f" | cut -f1)"
        done
    else
        echo "  nessuna"
    fi
    echo "Ore (ultime sessioni; totale in fondo):"
    lavori-ore sessioni "$nome"
}

nuovo() {
    local nome=${1:-} cart=${2:-} descr=${3:-} vero
    [ -n "$nome" ] && [ -n "$cart" ] || errore "uso: lavori nuovo <nome> <cartella> [\"descrizione\"]"
    [[ "$nome" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,23}$ ]] || errore "nome non valido: lettere (anche MAIUSCOLE), numeri, - e _ (max 24), es. Sito-Casa"
    [[ "$RISERVATI" == *" $nome "* ]] && errore "nome riservato: $nome"
    vero=$(canon "$nome"); [ -n "$vero" ] && errore "esiste gia' (anche con altre maiuscole): $vero -> $(campo "$vero" 3)"
    [[ "$descr" == *$'\t'* || "$descr" == *$'\n'* ]] && errore "la descrizione non puo' contenere tabulazioni o a capo"
    case "$cart" in *[[:space:]]*) errore "la cartella non puo' contenere spazi: $cart" ;; esac
    cart=$(realpath -m -- "$cart")
    case "$cart" in *[[:space:]]*) errore "la cartella non puo' contenere spazi: $cart" ;; esac
    case "$cart" in /|/etc|/usr|/bin|/sbin|/var|/proc|/sys|/dev|/boot) errore "cartella non adatta: $cart" ;; esac
    righe | awk -F'\t' -v c="$cart" '$3 == c { found=1 } END { exit !found }' && \
        errore "cartella gia' usata da un altro lavoro: $cart (stessa cartella = stesso contesto di Claude)"
    aperta "$nome" && errore "esiste gia' una sessione tmux \"$nome\" fuori dall'indice: chiudila o usa un altro nome"
    mkdir -p -- "$cart" || errore "non riesco a creare $cart"
    if [ ! -e "$cart/CLAUDE.md" ]; then
        cat > "$cart/CLAUDE.md" <<EOF
# Lavoro $nome

${descr:-(descrizione da scrivere)}

Lavoro SEPARATO dagli altri: qui si lavora solo su questo (cartella $cart).
Rispondere in italiano, dando del tu, breve e tecnico.

## Regole
- Una cosa alla volta e solo dopo l'ok.
- Backup prima di modificare.
- Confine: questo lavoro fa solo quello che c'e' scritto qui sopra. Se una richiesta fa un salto grosso fuori
  (tocca un altro progetto o un altro sistema, o installa pezzi piu' grossi di questo lavoro), fermati, dillo
  e proponi di aprire un altro lavoro con "lavori nuovo". Un lavoro non mette le mani negli altri.
  Se e' solo una domanda rispondi lo stesso; se ha senso farlo qui e chi lavora lo conferma, si fa.
  (Se questo lavoro deve restare LIBERO, perche' da qui nascono progetti nuovi, togli questa regola.)

## Stato
(da tenere aggiornato)
EOF
        echo "Creato $cart/CLAUDE.md: completalo, Claude lo legge all'avvio."
    fi
    modifica -v n="$nome" -v c="$cart" -v t="$(ora)" -v d="${descr:--}" \
        '{ print } END { print n, n, c, t, "-", d }'
    registra "nuovo $nome -> $cart"
    echo "Lavoro creato: $nome -> $cart.  Aprilo con: lavori $nome"
}

descrivi() {
    local descr=${2:-} nome
    nome=$(canon "${1:-}"); [ -n "$nome" ] || nome=${1:-}
    esiste "$nome" || errore "lavoro sconosciuto: ${1:-}"
    [ -n "$descr" ] || errore "uso: lavori descrivi <nome> \"descrizione\""
    [[ "$descr" == *$'\t'* || "$descr" == *$'\n'* ]] && errore "la descrizione non puo' contenere tabulazioni o a capo"
    modifica -v n="$nome" -v d="$descr" '$1 == n { $6 = d } { print }'
    echo "Descrizione di $nome aggiornata."
}

togli() {
    local nome
    nome=$(canon "${1:-}"); [ -n "$nome" ] || nome=${1:-}
    esiste "$nome" || errore "lavoro sconosciuto: ${1:-}"
    local cart; cart=$(campo "$nome" 3)
    read -r -p "Togliere \"$nome\" dall'indice? Cartella ($cart) e conversazioni restano. [s/N] " r
    [[ "$r" =~ ^[sS]$ ]] || { echo "Annullato."; exit 0; }
    modifica -v n="$nome" '$1 != n { print }'
    registra "tolto $nome ($cart)"
    echo "Tolto. Per rimetterlo: lavori nuovo $nome $cart"
}

guida_scelta() { local g; g=$(head -1 "$DIR/guida" 2>/dev/null); case "$g" in inglese|egiziana|plancia|torre) echo "$g" ;; *) echo europea ;; esac; }
guida_frase() { case "$1" in
    europea) echo "Guida europea: scrivi a sinistra, gli scambi con Claude stanno a destra." ;;
    torre)   echo "Guida torre: tre fasce una sopra l'altra: in alto le domande in sospeso, in mezzo le tue battute e le domande, in basso Claude Code largo tutto lo schermo." ;;
    plancia) echo "Guida plancia: sopra le domande di Claude in sospeso; sotto scrivi a sinistra, a destra le tue battute e le domande di Claude." ;;
    *)       echo "Guida $1: scrivi a destra, gli scambi con Claude stanno a sinistra." ;; esac; }
guida() {   # guida [europea|inglese|egiziana|plancia]: come si dispongono i pannelli attorno a Claude Code
    local g; g=$(printf '%s' "${1:-}" | tr 'A-Z' 'a-z')
    case "$g" in
        "") guida_frase "$(guida_scelta)"; echo "Per cambiare: lavori guida europea | inglese | egiziana | plancia | torre"; return ;;
        europea|inglese|egiziana|plancia|torre) ;;
        *) errore "guida sconosciuta: $1 (europea, inglese, egiziana, plancia o torre)" ;;
    esac
    printf '%s\n' "$g" > "$DIR/guida" || errore "non riesco a scrivere $DIR/guida"
    registra "guida $g"
    guida_frase "$g"; echo "Vale dalla prossima apertura di un lavoro; per le sessioni gia' aperte: iacopo off e poi iacopo on."
}

# --- Iacopostyle: i pannelli degli scambi attorno a Claude Code. Interruttore: iacopo on|off (la barra resta sempre)
stile_stato() { [ "$(head -1 "$DIR/stile" 2>/dev/null)" = off ] && echo off || echo on; }
_pannelli_scambi() { tmux list-panes -t "=$1:" -F '#{pane_id} #{pane_start_command}' 2>/dev/null | awk '/lavori-risposte/{print $1}'; }
_pannello_claude() { tmux list-panes -t "=$1:" -F '#{pane_id} #{pane_start_command}' 2>/dev/null | awk '!/lavori-risposte/{print $1; exit}'; }
barra() {   # barra <sessione>: la scritta nella barra in basso, accanto al nome. C'e' sempre, anche con la mod spenta
    local sess=$1
    # 2026-11-14: una riga sola a sinistra, accanto al nome: macchina, contatori, comando della mod, firma.
    # La scrive lavori-barra (si accorcia da sola se il terminale e' stretto); a destra non resta niente,
    # e l'elenco delle finestre (ce n'e' sempre una sola) si toglie per lasciarle il posto.
    local firma=""; [ -n "$FIRMA" ] || firma=" senzafirma"
    local cmd=/usr/local/bin/lavori-barra
    tmux set-option -t "=$sess:" status-left "[#{session_name}] #($cmd #{session_name}$firma)" 2>/dev/null || true
    # seconda riga (24/11): i tempi VERI di lavoro, sessione · lavoro · tutti
    tmux set-option -t "=$sess:" status 2 2>/dev/null || true
    # la riga [0] va rimessa uguale a quella globale: impostando solo la [1] per la sessione, tmux svuota la [0]
    tmux set-option -t "=$sess:" 'status-format[0]' "$(tmux show -gv 'status-format[0]' 2>/dev/null)" 2>/dev/null || true
    tmux set-option -t "=$sess:" 'status-format[1]' "#[align=left] #($cmd --tempi #{session_name})" 2>/dev/null || true
    tmux set-option -t "=$sess:" status-left-length 220 2>/dev/null || true
    tmux set-option -t "=$sess:" status-interval 5 2>/dev/null || true   # ogni 5 s: tempo e modello quasi dal vivo
    tmux set-option -t "=$sess:" status-right "" 2>/dev/null || true
    tmux set-option -w -t "=$sess:" window-status-format "" 2>/dev/null || true
    tmux set-option -w -t "=$sess:" window-status-current-format "" 2>/dev/null || true
}
vesti() {   # vesti <sessione> <nome> <colonne> <righe del terminale>: mette i pannelli degli scambi (se non ci sono gia')
    local sess=$1 nome=$2 col=$3 rig=$4 p lato=-h g
    # pannelli degli scambi (vedi "lavori guida"); solo se lo schermo e' largo
    [ "${LAVORI_RISPOSTE:-1}" != 0 ] && [ "$col" -ge "${LAVORI_RISPOSTE_MIN:-120}" ] && command -v lavori-risposte >/dev/null || return 0
    [ -z "$(_pannelli_scambi "$sess")" ] || return 0
    p=$(_pannello_claude "$sess"); [ -n "$p" ] || return 0
    g=$(guida_scelta)
    if [ "$g" = torre ] && [ "$rig" -ge 26 ]; then
        # torre (2026-11-10): tre fasce una sopra l'altra, larghe tutto lo schermo, simile a Claude Code da solo:
        # in alto le domande in sospeso, in mezzo le tue battute + le sue domande, in basso Claude Code (si scrive in fondo)
        local t sopra=${LAVORI_TORRE_SOPRA:-5} tu=${LAVORI_TORRE_TU:-8}      # righe: domande in sospeso, tue battute
        t=$(tmux split-window -vb -d -P -F '#{pane_id}' -l $((sopra + tu + 1)) -t "$p" "lavori-risposte '$nome' --tu" 2>/dev/null) || true
        [ -n "$t" ] && tmux split-window -vb -d -l "$sopra" -t "$t" "lavori-risposte '$nome' --sospese" 2>/dev/null || true
    elif [ "$g" = plancia ] && [ "$rig" -ge 26 ]; then
        # plancia: sopra le risposte di Claude; sotto Claude Code a sinistra, a destra le tue battute + le sue domande
        # 2026-11-10: sopra NON piu' le risposte di Claude (doppione di Claude Code) ma le DOMANDE IN SOSPESO (⏳ ?).
        # Per riavere le risposte sopra: LAVORI_SOPRA=claude
        tmux split-window -vb -d -l "${LAVORI_SOPRA_ALTEZZA:-30%}" -t "$p" "lavori-risposte '$nome' --${LAVORI_SOPRA:-sospese}" 2>/dev/null || true
        tmux split-window -h  -d -l 48% -t "$p" "lavori-risposte '$nome' --tu" 2>/dev/null || true
    else
        # di fianco. europea: scambi a destra; inglese/egiziana: a sinistra (plancia su schermo basso: come europea)
        case "$g" in inglese|egiziana) g=sinistra ;; *) g=destra ;; esac
        [ "${LAVORI_RISPOSTE_LATO:-$g}" = sinistra ] && lato=-hb
        tmux split-window $lato -d -l 60% -t "$p" "lavori-risposte '$nome'" 2>/dev/null || true
    fi
}
spoglia() {   # spoglia <sessione>: toglie i pannelli degli scambi, resta Claude Code da solo (la barra resta)
    local sess=$1 p
    [ -n "$(_pannello_claude "$sess")" ] || return 0     # mai chiudere l'ultimo pannello
    for p in $(_pannelli_scambi "$sess"); do tmux kill-pane -t "$p" 2>/dev/null || true; done
}
stile() {   # stile [on|off]: accende/spegne l'iacopostyle su tutte le sessioni aperte e su quelle nuove
    local v nome sess resto dim col rig n=0
    v=$(printf '%s' "${1:-}" | tr 'A-Z' 'a-z')
    case "$v" in
        "") echo "Iacopostyle: $(stile_stato)."; echo "Per cambiare: iacopo on | iacopo off   (vanno bene anche: lavori iacopo, lavori stile, lavori styl)"; return ;;
        on|off) ;;
        *) errore "uso: iacopo on | iacopo off" ;;
    esac
    printf '%s\n' "$v" > "$DIR/stile" || errore "non riesco a scrivere $DIR/stile"
    registra "iacopostyle $v"
    while IFS=$'\t' read -r nome sess resto; do
        aperta "$sess" || continue
        barra "$sess"
        if [ "$v" = on ]; then
            dim=$(tmux display-message -p -t "=$sess:" '#{window_width} #{window_height}' 2>/dev/null); col=${dim% *}; rig=${dim#* }
            [[ "$col" =~ ^[0-9]+$ && "$rig" =~ ^[0-9]+$ ]] || continue
            vesti "$sess" "$nome" "$col" $((rig+1))
        else
            spoglia "$sess"
        fi
        n=$((n+1))
    done < <(righe)
    tmux refresh-client -S 2>/dev/null || true
    if [ "$v" = on ]; then echo "Iacopostyle on: pannelli degli scambi su $n sessioni aperte e su quelle che aprirai."
    else echo "Iacopostyle off: Claude Code da solo, senza pannelli, su $n sessioni aperte e su quelle che aprirai. Per riaccendere: iacopo on"; fi
}

apri() {
    local nome=$1 id=${2:-} v
    v=$(canon "$nome"); [ -n "$v" ] && nome=$v
    esiste "$nome" || { echo "lavori: lavoro sconosciuto: $nome" >&2; echo; elenco; exit 1; }
    local sess cart; sess=$(campo "$nome" 2); cart=$(campo "$nome" 3)
    [ -d "$cart" ] || errore "la cartella non esiste: $cart"
    [ -z "$id" ] || [[ "$id" =~ ^[0-9a-f-]{36}$ ]] || errore "id di conversazione non valido: $id (vedi: lavori info $nome)"
    modifica -v n="$nome" -v t="$(ora)" '$1 == n { $5 = t } { print }'
    if aperta "$sess"; then
        [ -n "$id" ] && echo "La sessione \"$sess\" e' gia' aperta: ci entro (l'id serve solo se la sessione e' chiusa)."
        registra "apri $nome (riattacca)"
        if [ -n "${TMUX:-}" ]; then exec tmux switch-client -t "=$sess"; fi
        exec tmux attach -t "=$sess"
    fi
    local cmd
    if [ -n "$id" ]; then cmd="'$CLAUDE_BIN' --resume $id"
    else cmd="'$CLAUDE_BIN' --continue || '$CLAUDE_BIN'"; fi   # ultima conversazione della cartella, o una nuova
    local fine="echo; echo 'Claude chiuso. Invio per chiudere la sessione $sess (lavori $nome per riaprirla).'; read"
    registra "apri $nome (nuova sessione${id:+, conversazione $id})"
    local col rig; col=$(tput cols 2>/dev/null || echo 80); rig=$(tput lines 2>/dev/null || echo 24)
    [[ "$col" =~ ^[0-9]+$ ]] || col=80; [[ "$rig" =~ ^[0-9]+$ ]] || rig=24
    # la sessione nasce gia' grande come il terminale, cosi' i pannelli qui sotto hanno le misure giuste
    tmux new-session -d -s "$sess" -x "$col" -y "$rig" -c "$cart" "lavori-ore inizio '$nome'; cd '$cart' && $cmd; $fine; lavori-ore fine '$nome'" || errore "tmux non e' riuscito a creare la sessione"
    # la scritta nella barra c'e' sempre; i pannelli degli scambi solo se l'interruttore (iacopo on|off) e' acceso
    barra "$sess"
    [ "$(stile_stato)" = on ] && vesti "$sess" "$nome" "$col" "$rig"
    if [ -n "${TMUX:-}" ]; then exec tmux switch-client -t "=$sess"; fi
    exec tmux attach -t "=$sess"
}

# ---------------------------------------------------------------------------------------------------------
# Menu interattivo e promemoria
# ---------------------------------------------------------------------------------------------------------
NOMI=()
spiegazione() {
    cat <<'EOF2'
  Cos'è: ogni LAVORO è una cartella con la sua sessione tmux e Claude Code dentro.
   - Claude ricorda conversazioni e memoria PER CARTELLA: lavori diversi = contesti separati.
   - tmux tiene viva la sessione: se cade l'SSH, rientri con "lavori" e Claude è ancora lì.
   - Dentro: Ctrl-b poi d = esci lasciandolo acceso · Ctrl-b poi s = passa a un altro lavoro.
  Attenzione: le sessioni restano aperte come root e la finestra conserva quello che hai scritto
  (anche eventuali password): chiudi quelle che non usi. Avvertenze complete: lavori aiuto.
EOF2
}

stampa_menu() {
    if [ -z "$(righe)" ]; then
        NOMI=(); echo; echo "  Nessun lavoro ancora."; echo; spiegazione
        echo; echo "  n = nuovo lavoro   ·   q = esci"; return
    fi
    _render menu
    echo "  [numero] apri · 0 aggiornamenti$(oc_ce && echo " · $(( ${#NOMI[@]} + 1 )) opencode") · n nuovo · i dettagli · ? come funziona · a guida · q esci    ● aperto ○ chiuso ✗ manca"
}

# descrizione -> nome proposto in CamelCase ("my admin telegram bot" -> "MyAdminTelegramBot"), max 24
_nome_da_descrizione() {
    printf '%s' "$1" | sed 's/[^A-Za-z0-9]\+/ /g' \
      | awk '{o="";for(i=1;i<=NF;i++)o=o toupper(substr($i,1,1)) substr($i,2); print substr(o,1,24)}'
}

chiedi_nuovo() {
    local nome cart descr base r proposta
    echo
    echo "  ── Nuovo lavoro ──"
    read -r -p "  Descrizione (a cosa serve, in una riga; vuoto = annulla): " descr || return
    [ -z "$descr" ] && { echo "  Annullato."; return; }
    proposta=$(_nome_da_descrizione "$descr")
    # il nome proposto esce gia' scritto nel campo: con le FRECCE lo correggi/accorci, Invio conferma
    while :; do
        read -e -r -i "$proposta" -p "  Nome del lavoro (frecce per correggere/accorciare, Invio = ok): " nome || return
        nome=${nome// /}
        [ -z "$nome" ] && { echo "  Serve un nome."; continue; }
        if ! [[ "$nome" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,23}$ ]]; then echo "  Solo lettere, numeri, - e _ (max 24), niente spazi."; continue; fi
        if [[ "$RISERVATI" == *" $nome "* ]]; then echo "  \"$nome\" è riservato, scegline un altro."; continue; fi
        if [ -n "$(canon "$nome")" ]; then echo "  Esiste già (anche con altre maiuscole): $(canon "$nome")"; continue; fi
        break
    done
    if [ -d /Progetti ]; then base=/Progetti; else base=$HOME/lavori; fi
    read -e -r -i "$base/$nome" -p "  Cartella (frecce per correggere): " cart || return
    cart=${cart:-$base/$nome}
    echo
    echo "  Creo: $nome -> $cart — $descr"
    read -r -p "  Confermi? [S/n] " r || return
    [[ "$r" =~ ^[nN] ]] && { echo "  Annullato."; return; }
    ( nuovo "$nome" "$cart" "$descr" ) || return
    read -r -p "  Lo apro adesso? [S/n] " r || return
    [[ "$r" =~ ^[nN] ]] || apri "$nome"
}

menu() {
    local scelta n
    while :; do
        stampa_menu
        read -r -p "  Scelta: " scelta || { echo; exit 0; }
        case "$scelta" in
            q|Q|"")   exit 0 ;;
            0)        zero ;;
            n|N)      chiedi_nuovo ;;
            "?")      echo; spiegazione; read -r -p "  (Invio per tornare al menu) " _ ;;
            a|A)      echo; aiuto | ${PAGER:-less -R} ;;
            i|I)      read -r -p "  Dettagli di quale numero? " n
                      if [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le "${#NOMI[@]}" ]; then
                          echo; ( info "${NOMI[$((n - 1))]}" ); read -r -p "  (Invio per tornare al menu) " _
                      else echo "  Numero non valido."; fi ;;
            *)        if [[ "$scelta" =~ ^[0-9]+$ ]] && [ "$scelta" -ge 1 ] && [ "$scelta" -le "${#NOMI[@]}" ]; then
                          apri "${NOMI[$((scelta - 1))]}"
                      elif [ "$scelta" = "$(( ${#NOMI[@]} + 1 ))" ] && oc_ce; then opencode
                      elif esiste "$scelta"; then apri "$scelta"
                      else echo "  Non ho capito \"$scelta\": scrivi un numero, n, i, ?, a o q."; fi ;;
        esac
    done
}

promemoria() {   # per il login SSH: due righe, solo se non sei gia' dentro tmux
    [ -n "${TMUX:-}" ] && return 0
    local aperti
    aperti=$(righe | while IFS=$'\t' read -r nome sess _; do aperta "$sess" && printf '%s ' "$nome"; done)
    echo "💡 Claude Code: scrivi \"lavori\" per il menu dei lavori (ogni lavoro gira in tmux e non si perde se cade l'SSH)."
    if [ -n "$aperti" ]; then echo "   Già aperti: ${aperti% } → lavori <nome> per rientrare."
    else echo "   Nessun lavoro aperto. Nuovo: lavori → n."; fi
    echo "   Aggiornamenti: lavori 0 (terminale in tmux: se cade l'SSH il comando continua)."
}

# ---------------------------------------------------------------------------------------------------------
# Lavoro ZERO: il terminale degli aggiornamenti
# ---------------------------------------------------------------------------------------------------------
ZERO_DPKG=${LAVORI_DPKG:-/var/lib/dpkg}                    # LAVORI_DPKG / LAVORI_APTLOG: solo per le prove (stato finto,
ZERO_APTLOG=${LAVORI_APTLOG:-/var/log/apt/history.log}     # e allora il "mandalo avanti" non esegue niente)
ZERO_RIPRENDI="dpkg --configure -a && apt-get -f install"
ZERO_APT='apt|apt-get|aptitude|dpkg|unattended-upgr'

zero_stato() {   # stato degli aggiornamenti: c'e' un apt in corso (e dove)? qualcosa di incastrato? se si', lo manda avanti
    if ! command -v apt-get >/dev/null 2>&1 || ! command -v dpkg-query >/dev/null 2>&1; then
        echo " (su questa macchina non c'è apt: niente stato degli aggiornamenti)"; return 0
    fi
    local pid com tty da padre corso=0 fuori=0 meta nmeta rotti ult inizio fine n guai=0 r
    printf '\033[1m STATO DEGLI AGGIORNAMENTI\033[0m   %s\n' "$(date '+%d/%m %H:%M')"
    # 1. c'e' un apt o un dpkg che gira adesso? Dentro tmux o fuori?
    while read -r pid com; do
        [ -n "$pid" ] || continue
        padre=$(ps -o comm= -p "$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')" 2>/dev/null)
        [[ "$padre" =~ ^($ZERO_APT)$ ]] && continue          # il dpkg lanciato da apt: conta apt
        # "unattended-upgrade-shutdown" e' il guardiano sempre acceso di Debian, non un aggiornamento che gira
        tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q 'unattended-upgrade-shutdown' && continue
        corso=$((corso+1))
        tty=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' '); da=$(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ')
        if [ -z "$tty" ] || [ "$tty" = "?" ]; then
            printf ' \033[33m●\033[0m %s in corso da %s (pid %s), automatico, senza terminale: non dipende dal collegamento\n' "$com" "$da" "$pid"
        elif tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -q '^TMUX='; then
            printf ' \033[32m●\033[0m %s in corso da %s (pid %s) su %s, DENTRO tmux: se cade il collegamento continua\n' "$com" "$da" "$pid" "$tty"
        else
            fuori=$((fuori+1))
            printf ' \033[31m●\033[0m %s in corso da %s (pid %s) su %s, FUORI da tmux: se cade quel collegamento si interrompe\n' "$com" "$da" "$pid" "$tty"
        fi
    done < <(pgrep -l -x "$ZERO_APT" 2>/dev/null)
    if [ "$corso" -gt 0 ]; then
        echo "   Non lanciarne un altro e non toccare quello: lascialo finire."
        [ "$fuori" -gt 0 ] && echo "   Qui dentro non si può spostare. Se cade, torna qui e scrivi: lavori stato   (ti dice cosa è rimasto a metà e lo manda avanti)"
        echo "   I pacchetti a metà si controllano quando ha finito: lavori stato"
        return 0
    fi
    printf ' \033[32m✓\033[0m nessun apt o dpkg in corso\n'
    # 2. qualcosa di incastrato? pacchetti a meta', dpkg interrotto, ultimo aggiornamento cominciato e mai finito
    meta=$(dpkg-query --admindir="$ZERO_DPKG" -W -f='${db:Status-Abbrev}|${Package}\n' 2>/dev/null | awk -F'|' '{s=$1; gsub(/ /,"",s)} s!="ii" && s!="rc" && s!="hi" && s!="un" && s!="pn" {print $2}')
    nmeta=$(printf '%s' "$meta" | grep -c . || true)
    rotti=$(ls "$ZERO_DPKG/updates/" 2>/dev/null | grep -c '^[0-9]' || true)
    ult=$(awk '/^Start-Date:/{s=$2" "$3; e=""} /^End-Date:/{e=$2" "$3} END{print s"|"e}' "$ZERO_APTLOG" 2>/dev/null)
    inizio=${ult%%|*}; fine=${ult##*|}
    if [ "$nmeta" -gt 0 ]; then
        guai=1; printf ' \033[31m✗\033[0m %s pacchetti rimasti a metà: %s\n' "$nmeta" "$(printf '%s' "$meta" | head -8 | tr '\n' ' ')$([ "$nmeta" -gt 8 ] && echo ...)"
    fi
    if [ "$rotti" -gt 0 ]; then guai=1; printf ' \033[31m✗\033[0m dpkg è stato interrotto a metà di una scrittura (%s pezzi in sospeso)\n' "$rotti"; fi
    if [ -n "$inizio" ] && [ -z "$fine" ]; then guai=1; printf ' \033[31m✗\033[0m l'"'"'ultimo aggiornamento è cominciato il %s e non risulta finito\n' "$inizio"; fi
    if [ "$guai" = 0 ]; then
        printf ' \033[32m✓\033[0m niente di incastrato%s\n' "${fine:+ (ultimo aggiornamento finito il $fine)}"
    fi
    # 3. cosa resta da aggiornare (secondo l'ultimo apt-get update) e il riavvio
    zero_quanti
    zero_docker
    zero_automatici
    if [ -e /var/run/reboot-required ]; then
        printf ' \033[33m⚠\033[0m riavvio in sospeso%s\n' "$( [ -s /var/run/reboot-required.pkgs ] && printf ' per: %s' "$(sort -u /var/run/reboot-required.pkgs | tail -3 | tr '\n' ' ')")"
    fi
    [ "$guai" = 1 ] || return 0
    # 4. incastrato: i comandi per mandarlo avanti e, se siamo in tmux davanti a un terminale, lo fa lui
    echo
    echo " Per mandarlo avanti:   $ZERO_RIPRENDI"
    echo " e poi di nuovo:        apt-get upgrade"
    if [ ! -t 0 ] || [ ! -t 1 ]; then return 0; fi
    if [ -z "${TMUX:-}" ]; then echo " Non sei dentro tmux: entra con   lavori 0   e te lo chiede lì (così non si interrompe un'altra volta)."; return 0; fi
    read -r -p " Lo mando avanti adesso? [s/N] " r || return 0
    case "$r" in
        s|S|si|SI|sì) if [ -n "${LAVORI_DPKG:-}" ]; then echo " (prova: non eseguo niente)"; return 0; fi
                      registra "aggiornamenti: mandato avanti ($ZERO_RIPRENDI)"
                      dpkg --configure -a && apt-get -f install
                      echo; echo " Finito (esito $?). Adesso: apt-get upgrade   ·   per ricontrollare: lavori stato" ;;
        *)            echo " Lasciato com'è." ;;
    esac
}

zero_incastrato() {   # 0 (vero) se l'ultimo aggiornamento non ha finito: pacchetti a metà, dpkg interrotto, apt senza fine
    local meta rotti ult
    meta=$(dpkg-query --admindir="$ZERO_DPKG" -W -f='${db:Status-Abbrev}|${Package}\n' 2>/dev/null | awk -F'|' '{s=$1; gsub(/ /,"",s)} s!="ii" && s!="rc" && s!="hi" && s!="un" && s!="pn" {print $2}')
    [ -n "$meta" ] && return 0
    rotti=$(ls "$ZERO_DPKG/updates/" 2>/dev/null | grep -c '^[0-9]' || true)
    [ "$rotti" -gt 0 ] && return 0
    ult=$(awk '/^Start-Date:/{s=$2" "$3; e=""} /^End-Date:/{e=$2" "$3} END{print s"|"e}' "$ZERO_APTLOG" 2>/dev/null)
    [ -n "${ult%%|*}" ] && [ -z "${ult##*|}" ] && return 0
    return 1
}

zero_docker_pk() {   # i pacchetti di Docker tra quelli che apt aggiornerebbe (anche con full-upgrade)
    LC_ALL=C apt-get -s -o Debug::NoLocking=1 dist-upgrade 2>/dev/null | awk '/^Inst /{print $2}' | grep -xE "$ZERO_DOCKER_PKG" | xargs
}

zero_comandi() {   # i comandi della freccia SU, uno per riga, nell'ordine in cui escono (il primo = una pressione)
    command -v apt-get >/dev/null 2>&1 || return 0
    local tutto="apt update && apt full-upgrade" pk
    pk=$(zero_docker_pk)
    # Docker da aggiornare: tutto il resto sì, Docker no (resta bloccato e poi si sblocca: va fatto a parte, da console)
    [ -n "$pk" ] && tutto="apt-mark hold $pk && apt update && apt full-upgrade; apt-mark unhold $pk"
    if zero_incastrato; then
        echo "$ZERO_RIPRENDI && $tutto"
        echo "$ZERO_RIPRENDI"
    else
        echo "$tutto"
    fi
    echo "apt update"
    echo "apt upgrade"
    echo "apt dist-upgrade"
    [ -n "$pk" ] && echo "apt update && apt full-upgrade"
    return 0
}

zero_quanti() {   # quanti pacchetti installerebbe davvero «apt-get upgrade» (prova a secco, vale per Debian e Ubuntu)
    local sim n tenuti fasi
    sim=$(LC_ALL=C apt-get -s -o Debug::NoLocking=1 upgrade 2>/dev/null)
    n=$(printf '%s\n' "$sim" | grep -c '^Inst ' || true)
    echo " · da aggiornare: $n pacchetti con apt-get upgrade (secondo l'ultimo apt-get update)"
    tenuti=$(printf '%s\n' "$sim" | awk '/kept back:/{f=1;next} /^[^ ]/{f=0} f' | xargs 2>/dev/null)
    [ -n "$tenuti" ] && echo "   trattenuti (vogliono pacchetti nuovi o tolti: apt-get dist-upgrade / apt full-upgrade): $tenuti"
    # Ubuntu: «phased updates», il pacchetto arriva a scaglioni e apt lo rimanda da solo: non è un guasto
    fasi=$(printf '%s\n' "$sim" | awk '/deferred due to phasing:/{f=1;next} /^[^ ]/{f=0} f' | xargs 2>/dev/null)
    [ -n "$fasi" ] && echo "   rimandati da Ubuntu (aggiornamenti a scaglioni, arrivano da soli nei prossimi giorni): $fasi"
    return 0
}

ZERO_DOCKER_PKG='docker-ce|docker-ce-cli|docker-ce-rootless-extras|docker-buildx-plugin|docker-compose-plugin|containerd\.io|containerd|docker\.io|runc|moby-.*'

zero_contenitore_di() {   # nome del contenitore Docker a cui appartiene un processo (vuoto se non è in un contenitore)
    local id
    id=$(grep -oE '(docker|containerd)[-/]?[0-9a-f]{64}' "/proc/$1/cgroup" 2>/dev/null | grep -oE '[0-9a-f]{64}' | head -1)
    [ -n "$id" ] || return 0
    docker inspect -f '{{.Name}}' "$id" 2>/dev/null | sed 's#^/##' | grep . || echo "${id:0:12}"
}

zero_docker() {   # aggiornare Docker riavvia Docker: si fermano i contenitori e cadono le connessioni che ci passano
    command -v docker >/dev/null 2>&1 || command -v containerd >/dev/null 2>&1 || return 0
    local pk vie=0 riga peer dev pid fd cont
    pk=$(zero_docker_pk)
    if command -v snap >/dev/null 2>&1 && snap list docker >/dev/null 2>&1; then
        printf ' \033[33m⚠\033[0m Docker è uno snap: si aggiorna (e si riavvia) da solo quando snapd decide. Per fermarlo: snap refresh --hold docker\n'
    fi
    # le connessioni SSH di adesso passano da un contenitore? (VPN, Tailscale, tunnel che girano dentro Docker)
    while read -r riga; do
        peer=$(printf '%s' "$riga" | awk '{print $4}'); peer=${peer%:*}; peer=${peer#[}; peer=${peer%]}
        [ -n "$peer" ] || continue
        dev=$(ip route get "$peer" 2>/dev/null | grep -oE ' dev [^ ]+' | head -1 | awk '{print $2}')
        cont=""
        case "$dev" in
            docker0|br-*|veth*) cont="rete Docker ($dev)" ;;
            "") ;;
            *)  for fd in $(find /proc/[0-9]*/fd -lname /dev/net/tun 2>/dev/null); do
                    grep -qx "iff:[[:space:]]*$dev" "${fd%/fd/*}/fdinfo/${fd##*/}" 2>/dev/null || continue
                    pid=${fd#/proc/}; pid=${pid%%/*}
                    cont=$(zero_contenitore_di "$pid"); [ -n "$cont" ] && cont="$dev, creata dal contenitore $cont"
                    break
                done ;;
        esac
        if [ -n "$cont" ]; then
            vie=$((vie+1))
            printf ' \033[31m⚠\033[0m la connessione SSH da %s passa da Docker (%s): se Docker si riavvia, cade\n' "$peer" "$cont"
        fi
    done < <(ss -Htnp state established 2>/dev/null | grep -E '"sshd' | awk '{print $1, $2, $3, $4}')
    [ -n "$pk" ] || { [ "$vie" -gt 0 ] && echo "   (oggi non ci sono aggiornamenti di Docker: vale per quando ci saranno)"; return 0; }
    printf ' \033[31m⚠\033[0m tra gli aggiornamenti c'"'"'è Docker: %s\n' "$pk"
    echo "   Aggiornarlo RIAVVIA Docker: si fermano e ripartono i contenitori (anche quelli di Docker senza root)"
    echo "   e cadono le connessioni che passano da un contenitore (VPN, Tailscale, proxy, tunnel)."
    echo "   Prima il resto, Docker per ultimo e da una strada che non passa da Docker (console del provider, altra rete):"
    echo "       apt-mark hold $pk && apt-get upgrade"
    echo "       apt-mark unhold $pk && apt-get upgrade      <- questo da console"
    echo "   Dopo: docker ps -a   (controllare che tutti i contenitori siano ripartiti, non sempre lo fanno da soli)"
    return 0
}

zero_automatici() {   # chi aggiorna o riavvia da solo, senza chiedere
    local f riav
    if command -v needrestart >/dev/null 2>&1; then
        echo " · needrestart è installato (su Ubuntu c'è di serie): dopo l'aggiornamento riavvia i servizi, Docker compreso."
        echo "   Per vedere soltanto, senza riavviare niente:   NEEDRESTART_MODE=l apt-get upgrade"
    fi
    f=$(ls /etc/apt/apt.conf.d/*unattended* /etc/apt/apt.conf.d/*auto-upgrades* 2>/dev/null)
    [ -n "$f" ] || return 0
    if grep -hqsE '^[^/]*APT::Periodic::Unattended-Upgrade[^"]*"1"' $f; then
        echo " · aggiornamenti automatici accesi (unattended-upgrades): di solito solo quelli di sicurezza della distribuzione"
        grep -hsE '^[^/]*(docker|download\.docker\.com)' $f >/dev/null && printf ' \033[31m⚠\033[0m   e tra le fonti automatiche c'"'"'è anche Docker: si può riavviare da solo\n'
        riav=$(grep -hsE '^[^/]*Unattended-Upgrade::Automatic-Reboot[^"]*"true"' $f)
        [ -n "$riav" ] && printf ' \033[33m⚠\033[0m   con riavvio automatico della macchina acceso (Automatic-Reboot): dopo, controllare i contenitori\n'
    fi
    return 0
}

zero_nota() {   # le righe in testa al terminale del lavoro zero: come si rientra, lo stato, i comandi
    printf '\033[1m LAVORO 0 · %s\033[0m   terminale di root dentro tmux, senza Claude\n' "$ZERO_NOME"
    echo " Se cade il collegamento il comando CONTINUA: rientra con   lavori 0"
    echo " Staccarsi senza chiudere: Ctrl-b d   ·   rileggere in su: Ctrl-b [ poi PagSu (q esce)   ·   chiudere: exit"
    echo
    if command -v apt-get >/dev/null 2>&1; then
        echo " Aggiornare (da qui dentro):   apt-get update && apt-get upgrade      (Ubuntu e Debian: uguale)"
        echo " Già pronti con la freccia SU (poi Invio):"
        local i=0 c
        while IFS= read -r c; do i=$((i+1)); printf '   %s ↑  %s\n' "$i" "$c"; done < <(zero_comandi)
        echo "   «apt full-upgrade» = upgrade + dist-upgrade in un colpo: chiede il Sì una volta sola."
        echo " Cambio di versione:           Ubuntu: do-release-upgrade   ·   Debian: cambiare il nome in sources e apt full-upgrade"
        echo " Docker per ultimo: riavviarlo fa cadere i contenitori e le connessioni che ci passano (vedi sotto)"
        echo " Riprendere uno interrotto, anche se era partito FUORI da tmux ed è caduto:"
        echo "                               $ZERO_RIPRENDI      poi di nuovo: apt-get upgrade"
        echo " Rivedere lo stato:            lavori stato"
        echo
        zero_stato
        echo
    fi
}

# Comandi pronti con la freccia SU nel terminale del lavoro zero (zero_comandi: il primo è quello giusto adesso)
ZERO_RC=${LAVORI_ZERO_RC:-$DIR/zero-bashrc}
zero_bashrc() {   # scrive il file di avvio della shell del lavoro zero (bash normale + i comandi pronti nella cronologia)
    mkdir -p "$(dirname "$ZERO_RC")" 2>/dev/null || return 1
    cat > "$ZERO_RC.nuovo" <<'FINE' || return 1
# Scritto da «lavori 0»: shell del lavoro zero. Si rifà da solo a ogni sessione nuova, non modificare a mano.
[ -f /etc/bash.bashrc ] && . /etc/bash.bashrc
[ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"
HISTCONTROL=ignoreboth:erasedups
FINE
    local io; io=$(readlink -f "$0" 2>/dev/null || echo "$0")
    cat >> "$ZERO_RC.nuovo" <<FINE || return 1
# freccia SU: i comandi di «lavori zero-comandi», calcolati all'apertura (il primo che esce è quello giusto adesso:
# lo sblocco se l'ultimo aggiornamento non ha finito, altrimenti tutto attaccato)
while IFS= read -r _c; do [ -n "\$_c" ] && history -s "\$_c"; done < <('$io' zero-comandi | tac)
unset _c
FINE
    mv -f "$ZERO_RC.nuovo" "$ZERO_RC"
}

opencode() {   # la sessione fissa di OpenCode: la riattacca o la crea, come l'utente che lancia lavori
    oc_ce || errore "OpenCode non trovato per l'utente $(id -un) (né ~/.opencode/bin/opencode né opencode nel PATH)"
    if aperta "$OC_SESS"; then
        registra "apri $OC_NOME (riattacca)"
    else
        local col rig; col=$(tput cols 2>/dev/null || echo 80); rig=$(tput lines 2>/dev/null || echo 24)
        [[ "$col" =~ ^[0-9]+$ ]] || col=80; [[ "$rig" =~ ^[0-9]+$ ]] || rig=24
        local fine="echo; echo 'OpenCode chiuso. Invio per chiudere la sessione (lavori opencode per riaprirla).'; read"
        mkdir -p "$OC_CARTELLA" || errore "non riesco a creare $OC_CARTELLA"
        registra "apri $OC_NOME (nuova sessione, utente $(id -un))"
        tmux new-session -d -s "$OC_SESS" -x "$col" -y "$rig" -c "$OC_CARTELLA" "cd '$OC_CARTELLA' && '$OC_CMD'; $fine" \
            || errore "tmux non e' riuscito a creare la sessione"
        barra "$OC_SESS"
    fi
    if [ -n "${TMUX:-}" ]; then exec tmux switch-client -t "=$OC_SESS"; fi
    exec tmux attach -t "=$OC_SESS"
}

zero() {
    if aperta "$ZERO_SESS"; then
        registra "apri $ZERO_NOME (riattacca)"
    else
        local col rig; col=$(tput cols 2>/dev/null || echo 80); rig=$(tput lines 2>/dev/null || echo 24)
        [[ "$col" =~ ^[0-9]+$ ]] || col=80; [[ "$rig" =~ ^[0-9]+$ ]] || rig=24
        local io; io=$(readlink -f "$0" 2>/dev/null || echo "$0")   # percorso intero: la sessione nasce in un'altra cartella
        registra "apri $ZERO_NOME (nuova sessione)"
        local dopo="exec \"\${SHELL:-/bin/bash}\" -l"
        if command -v bash >/dev/null 2>&1; then
            zero_bashrc && dopo="exec bash --rcfile '$ZERO_RC' -i"
        fi
        tmux new-session -d -s "$ZERO_SESS" -x "$col" -y "$rig" -c "$HOME" "'$io' zero-nota; $dopo" \
            || errore "tmux non e' riuscito a creare la sessione"
    fi
    if [ -n "${TMUX:-}" ]; then exec tmux switch-client -t "=$ZERO_SESS"; fi
    exec tmux attach -t "=$ZERO_SESS"
}

aiuto() { sed -n '2,/^set -uo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }

# OpenCode prima del controllo di root: gira come chi lo lancia, anche un utente normale
case "$(printf '%s' "${1:-}" | tr 'A-Z' 'a-z')" in opencode) opencode ;; esac
prepara
case "$(printf '%s' "${1:-}" | tr 'A-Z' 'a-z')" in iacopo|iacopostyle|stile|styl) stile "${2:-}"; exit ;; esac
case "$(printf '%s' "${1:-}" | tr 'A-Z' 'a-z')" in 0|zero|aggiornamenti) zero ;; zero-nota) zero_nota; exit ;; zero-comandi) zero_comandi; exit ;; stato) zero_stato; exit ;; esac
case "${1:-}" in
    "")                 if [ -t 0 ] && [ -t 1 ]; then menu; else elenco; fi ;;
    menu)               menu ;;
    elenco)             elenco ;;
    promemoria)         promemoria ;;
    aiuto|-h|--help|help) aiuto ;;
    nuovo)              shift; nuovo "$@" ;;
    info)               [ -n "${2:-}" ] || errore "uso: lavori info <nome>"; info "$2" ;;
    descrivi)           shift; descrivi "$@" ;;
    togli)              shift; togli "$@" ;;
    guida)              guida "${2:-}" ;;
    ore)                if [ -n "${2:-}" ]; then v=$(canon "$2"); [ -n "$v" ] || errore "lavoro sconosciuto: $2"; else v=""; fi; exec lavori-ore mostra "$v" ;;
    -*)                 errore "opzione sconosciuta: $1 (lavori aiuto)" ;;
    *)                  apri "$@" ;;
esac
